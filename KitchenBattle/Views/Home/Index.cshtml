@model IEnumerable<KitchenBattle.Models.Battle>
@{
    ViewData["Title"] = "Головна";
    int index = 0;
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-4">Kitchen Battle</h1>
        <p class="lead text-muted">Ароматні, яскраві та захопливі кулінарні батли — переглянь останні події та рецепти!</p>
    </div>

    <div class="row g-4 justify-content-center align-items-stretch">
        @foreach (var battle in Model)
        {
            var cardClass = (index % 2 == 0) ? "card-green" : "card-yellow";

            var battleImage = battle.Category switch
            {
                CategoryEnum.Dessert => "https://images.unsplash.com/photo-1565958011703-44f9829ba187?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.MainCourse => "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Seafood => "https://images.unsplash.com/photo-1559847844-5315695dadae?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Meat => "https://images.unsplash.com/photo-1558030006-450675393462?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Breakfast => "https://images.unsplash.com/photo-1482049016688-2d3e1b311543?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Snack => "https://images.unsplash.com/photo-1565299585323-38d6b0865b47?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Vegetarian => "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Soup => "https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.Sauce => "https://images.unsplash.com/photo-1476224203421-9ac39bcb3327?auto=format&fit=crop&w=900&q=80",
                CategoryEnum.HolidaySpecial => "https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&w=900&q=80",
                _ => "https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=900&q=80"
            };

            var statusValue = battle.Status.ToString();

            var statusText = statusValue switch
            {
                "Pending" => "Очікується",
                "InProgress" => "В процесі",
                "Completed" => "Завершено",
                "Closed" => "Закрита реєстрація",
                _ => statusValue
            };

            var statusClass = statusValue switch
            {
                "Pending" => "status-pending",
                "InProgress" => "status-progress",
                "Completed" => "status-completed",
                "Closed" => "status-closed",
                _ => "status-default"
            };

            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="card shadow-sm border-0 @cardClass battle-card w-100">
                    <img src="@battleImage" class="card-img-top battle-card-img" alt="@battle.BattleName">

                    <div class="card-body battle-card-body">
                        <h5 class="card-title fw-bold">@battle.BattleName</h5>

                        <p class="card-text text-muted battle-card-description">
                            @battle.Description
                        </p>

                        <div class="mt-auto">
                            <span class="battle-status-badge @statusClass">@statusText</span>

                            <small class="text-muted d-block mt-2 mb-3">
                                Початок: @battle.StartedAt.ToShortDateString()
                            </small>

                            <a href="@Url.Action("Index", "Battles")" class="btn btn-kitchen w-100">
                                Переглянути батли
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            index++;
        }
    </div>

    <div class="row justify-content-center text-center mt-5">
        <div class="col-md-4 mb-3">
            <div class="p-4 bg-light rounded shadow-sm">
                <h5 class="fw-bold">Рецепти</h5>
                <p class="text-muted">Переглянь найкращі страви учасників.</p>
                <a href="@Url.Action("Index", "Recipes")" class="btn w-100 btn-success btn-kitchen-secondary">Переглянути рецепти</a>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="p-4 bg-light rounded shadow-sm">
                <h5 class="fw-bold">Лідерборд</h5>
                <p class="text-muted">Дізнайся, хто зараз на вершині!</p>
                <a href="@Url.Action("Index", "Leaderboard")" class="btn w-100 btn-warning btn-kitchen-secondary">Лідерборд</a>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="p-4 bg-light rounded shadow-sm">
                <h5 class="fw-bold">Політика конфіденційності</h5>
                <p class="text-muted">Дізнайся, як ми захищаємо твої дані.</p>
                <a href="@Url.Action("Privacy", "Home")" class="btn w-100 btn-secondary btn-kitchen-secondary">Політика конфіденційності</a>
            </div>
        </div>
    </div>
</div>