@model IEnumerable<KitchenBattle.Models.Score>

@{
    ViewData["Title"] = "Оцінки рецепту";
    int recipeId = ViewBag.RecipeId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-star-half text-warning me-2"></i>Оцінки рецепту
    </h2>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Judge"))
        {
            <a asp-action="Create" asp-route-recipeId="@recipeId" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Додати оцінку
            </a>
        }
        <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipeId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>До рецепту
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-star fs-1 d-block mb-3"></i>
        <p class="fs-5">Ще немає жодних оцінок для цього рецепту.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var score in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="mb-0 fw-bold">
                                    <i class="bi bi-person-circle me-1 text-muted"></i>
                                    Суддя #@score.JudgeId.Substring(0, 8)
                                </h6>
                            </div>
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-star-fill me-1"></i>@score.TotalScore / 30
                            </span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="text-muted">Смак</small>
                                <small class="fw-semibold">@score.Taste / 10</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-danger" style="width: @(score.Taste * 10)%"></div>
                            </div>

                            <div class="d-flex justify-content-between mb-1 mt-2">
                                <small class="text-muted">Презентація</small>
                                <small class="fw-semibold">@score.Presentation / 10</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-info" style="width: @(score.Presentation * 10)%"></div>
                            </div>

                            <div class="d-flex justify-content-between mb-1 mt-2">
                                <small class="text-muted">Креативність</small>
                                <small class="fw-semibold">@score.Creativity / 10</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: @(score.Creativity * 10)%"></div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(score.Comments))
                        {
                            <blockquote class="blockquote mb-0 border-start border-3 border-warning ps-3">
                                <p class="small fst-italic mb-0 text-muted">@score.Comments</p>
                            </blockquote>
                        }
                    </div>

                    @if (User.IsInRole("Judge"))
                    {
                        <div class="card-footer bg-transparent d-flex gap-2 justify-content-end border-0 pt-0">
                            <a asp-action="Edit" asp-route-id="@score.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Редагувати
                            </a>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Видалити оцінку?');">
                                <input type="hidden" name="id" value="@score.Id" />
                                <input type="hidden" name="recipeId" value="@recipeId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Видалити
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
