@model List<KitchenBattle.ViewModels.ScoreDisplayViewModel>

@{
    ViewData["Title"] = "Оцінки рецепту";
    int recipeId = ViewBag.RecipeId;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<div class="scores-page">
    <div class="container">
        <div class="scores-page-header">
            <div>
                <h1 class="scores-page-title">
                    Оцінки рецепту
                    <span>Результати суддівського журі</span>
                </h1>
            </div>
            <div class="header-actions">
                @if (User.IsInRole("Judge"))
                {
                    <a asp-action="Create" asp-route-recipeId="@recipeId" class="btn-primary-kb">
                        <i class="bi bi-plus-lg"></i>Додати оцінку
                    </a>
                }
                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipeId" class="btn-outline-kb">
                    <i class="bi bi-arrow-left"></i>До рецепту
                </a>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="scores-summary">
                <div class="summary-stat">
                    <div class="stat-value">@Model.Count</div>
                    <div class="stat-label">Суддів оцінили</div>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-stat">
                    <div class="stat-value">@Model.Sum(s => s.TotalScore)</div>
                    <div class="stat-label">Загальних балів</div>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-stat">
                    <div class="stat-value">@(Model.Average(s => s.TotalScore).ToString("0.0"))</div>
                    <div class="stat-label">Середній бал</div>
                </div>
                <div class="summary-divider"></div>
                <div class="summary-stat">
                    <div class="stat-value">@Model.Max(s => s.TotalScore)</div>
                    <div class="stat-label">Найвища оцінка</div>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var score in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="score-card">
                            <div class="score-card-accent"></div>
                            <div class="score-card-body">
                                <div class="judge-row">
                                    <div class="judge-info">
                                        <div class="judge-avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="judge-name">@score.JudgeName</div>
                                            <div class="judge-role">Суддя</div>
                                        </div>
                                    </div>
                                    <div class="score-badge">@score.TotalScore / 30</div>
                                </div>

                                <div class="criteria-list">
                                    <div class="criterion">
                                        <div class="criterion-top">
                                            <span class="criterion-name">
                                                <i class="bi bi-fire"></i> Смак
                                            </span>
                                            <span class="criterion-score">@score.Taste / 10</span>
                                        </div>
                                        <div class="kb-progress">
                                            <div class="kb-progress-bar bar-taste" style="width: @(score.Taste * 10)%"></div>
                                        </div>
                                    </div>
                                    <div class="criterion">
                                        <div class="criterion-top">
                                            <span class="criterion-name">
                                                <i class="bi bi-palette"></i> Презентація
                                            </span>
                                            <span class="criterion-score">@score.Presentation / 10</span>
                                        </div>
                                        <div class="kb-progress">
                                            <div class="kb-progress-bar bar-present" style="width: @(score.Presentation * 10)%"></div>
                                        </div>
                                    </div>
                                    <div class="criterion">
                                        <div class="criterion-top">
                                            <span class="criterion-name">
                                                <i class="bi bi-lightbulb"></i> Креативність
                                            </span>
                                            <span class="criterion-score">@score.Creativity / 10</span>
                                        </div>
                                        <div class="kb-progress">
                                            <div class="kb-progress-bar bar-creativity" style="width: @(score.Creativity * 10)%"></div>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(score.Comments))
                                {
                                    <div class="score-comment">
                                        @score.Comments
                                    </div>
                                }
                            </div>

                            @if (User.IsInRole("Judge"))
                            {
                                <div class="score-card-footer">
                                    <a asp-action="Edit" asp-route-id="@score.Id" class="btn-card-edit">
                                        <i class="bi bi-pencil"></i> Редагувати
                                    </a>
                                    <form asp-action="Delete" method="post" style="margin:0;"
                                          onsubmit="return confirm('Видалити оцінку?');">
                                        <input type="hidden" name="id" value="@score.Id" />
                                        <input type="hidden" name="recipeId" value="@recipeId" />
                                        <button type="submit" class="btn-card-delete">
                                            <i class="bi bi-trash"></i> Видалити
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state-scores">
                <div class="empty-icon-wrap">
                    <i class="bi bi-star"></i>
                </div>
                <h5>Оцінок ще немає</h5>
                <p>Суддівське журі ще не виставило жодної оцінки для цього рецепту.</p>
                @if (User.IsInRole("Judge"))
                {
                    <a asp-action="Create" asp-route-recipeId="@recipeId" class="btn-primary-kb mt-4 d-inline-flex">
                        <i class="bi bi-plus-lg"></i>Бути першим суддею
                    </a>
                }
            </div>
        }
    </div>
</div>