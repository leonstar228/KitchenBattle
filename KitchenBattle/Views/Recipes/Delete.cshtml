@model KitchenBattle.Models.Recipe
@{
    ViewData["Title"] = "Видалення рецепта";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --clr-green: #4A6741;
        --clr-gold: #C47B2B;
        --clr-gold-light: #E8D5A3;
        --clr-ivory: #F5F1E8;
        --clr-white: #FFFFFF;
        --clr-dark: #2C2C2A;
        --clr-brown: #8B7355;
        --clr-red: #D4483B;
        --radius-card: 16px;
        --radius-btn: 6px;
        --radius-pill: 20px;
        --shadow-card: 0 8px 32px rgba(0,0,0,0.1);
        --transition: 0.3s ease;
    }

    body {
        background: var(--clr-ivory) !important;
    }

    .del-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        padding: 60px 0;
    }

    .del-card {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        border-top: 4px solid var(--clr-red);
        animation: popIn .45s cubic-bezier(.34,1.56,.64,1) both;
    }

    @@keyframes popIn {
        from {
            opacity: 0;
            transform: scale(.88);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .del-top {
        background: linear-gradient(135deg, var(--clr-red), #b8392e);
        padding: 32px;
        text-align: center;
    }

    .del-icon {
        font-size: 52px;
        color: rgba(255,255,255,.9);
        margin-bottom: 12px;
    }

    .del-top h3 {
        font-family: 'Biryani',sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: var(--clr-white);
        margin: 0;
    }

    .del-body {
        padding: 32px;
        text-align: center;
    }

    .del-text {
        font-size: 15px;
        color: var(--clr-dark);
        margin-bottom: 20px;
    }

    .recipe-box {
        background: var(--clr-ivory);
        border-radius: 12px;
        padding: 16px 24px;
        margin: 0 auto 24px;
        display: inline-block;
        border-left: 4px solid var(--clr-red);
        text-align: left;
    }

    .recipe-box-name {
        font-family: 'Biryani',sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: var(--clr-dark);
        margin-bottom: 5px;
    }

    .recipe-box-meta {
        font-size: 13px;
        color: var(--clr-brown);
    }

    .danger-note {
        background: rgba(212,72,59,.07);
        border: 1px solid rgba(212,72,59,.2);
        border-radius: var(--radius-btn);
        padding: 10px 16px;
        font-size: 13px;
        color: var(--clr-red);
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        gap: 7px;
        justify-content: center;
    }

    .action-row {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .btn-confirm {
        background: var(--clr-red);
        color: var(--clr-white);
        border: none;
        border-radius: var(--radius-btn);
        padding: 12px 32px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-confirm:hover {
            background: #b8392e;
            color: var(--clr-white);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(212,72,59,.35);
        }

    .btn-cancel {
        background: transparent;
        color: var(--clr-brown);
        border: 1.5px solid #C8C0B4;
        border-radius: var(--radius-btn);
        padding: 12px 28px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition);
    }

        .btn-cancel:hover {
            border-color: var(--clr-green);
            color: var(--clr-green);
        }
</style>

<div class="del-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-sm-8">
                <div class="del-card">
                    <div class="del-top">
                        <div class="del-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                        <h3>Підтвердження видалення</h3>
                    </div>
                    <div class="del-body">
                        <p class="del-text">Ви впевнені, що хочете видалити цей рецепт?</p>

                        <div class="recipe-box">
                            <div class="recipe-box-name">@Model.Title</div>
                            <div class="recipe-box-meta">
                                <i class="bi bi-person"></i> @Model.ChefName
                                &nbsp;·&nbsp;
                                <i class="bi bi-tag"></i> @Model.Category
                            </div>
                        </div>

                        <div class="danger-note">
                            <i class="bi bi-shield-exclamation"></i>
                            Цю дію не можна буде скасувати!
                        </div>

                        <div class="action-row">
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit" class="btn-confirm">
                                    <i class="bi bi-trash"></i> Так, видалити
                                </button>
                            </form>
                            <a asp-action="MyRecipes" class="btn-cancel">
                                <i class="bi bi-x"></i> Скасувати
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>