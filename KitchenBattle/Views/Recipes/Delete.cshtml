@model KitchenBattle.Models.Recipe
@{
    ViewData["Title"] = "Видалення рецепта";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<div class="del-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-sm-8">
                <div class="del-card">
                    <div class="del-top">
                        <div class="del-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                        <h3>Підтвердження видалення</h3>
                    </div>
                    <div class="del-body">
                        <p class="del-text">Ви впевнені, що хочете видалити цей рецепт?</p>

                        <div class="recipe-box">
                            <div class="recipe-box-name">@Model.Title</div>
                            <div class="recipe-box-meta">
                                <i class="bi bi-person"></i> @Model.ChefName
                                &nbsp;·&nbsp;
                                <i class="bi bi-tag"></i> @Model.Category
                            </div>
                        </div>

                        <div class="danger-note">
                            <i class="bi bi-shield-exclamation"></i>
                            Цю дію не можна буде скасувати!
                        </div>

                        <div class="action-row">
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="Id" />
                                <button type="submit" class="btn-confirm">
                                    <i class="bi bi-trash"></i> Так, видалити
                                </button>
                            </form>
                            <a asp-action="MyRecipes" class="btn-cancel">
                                <i class="bi bi-x"></i> Скасувати
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>