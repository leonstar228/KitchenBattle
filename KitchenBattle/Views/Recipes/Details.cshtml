@using System.Security.Claims
@model KitchenBattle.ViewModels.RecipeDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4 recipes-page">

    <div class="d-flex justify-content-start mb-3">
        <a asp-action="Index" class="btn btn-outline-kitchen btn-sm">
            <i class="bi bi-arrow-left"></i> Назад до рецептів
        </a>
    </div>

    <!-- Two-column details: image left, content right -->
    <div class="details-grid">
        <div class="left-col">
            <div class="image-wrapper">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src='@Url.Content(Model.ImageUrl)' alt="@Model.Title" />
                }
                else
                {
                    <!-- Зелений квадрат з іконкою камери по центру (як у списку рецептів) -->
                    <div class="image-placeholder d-flex align-items-center justify-content-center" style="height: 100%; width: 100%; background: linear-gradient(135deg, #4A6741, #6B8F5E);">
                        <i class="bi bi-camera-fill" style="font-size: 64px; color: rgba(255,255,255,0.85);"></i>
                    </div>
                }
            </div>
        </div>

        <div class="right-col">
            <!-- Invisible square wrapper that groups the summary + two panels -->
            <div class="right-card-wrapper">
                <div class="recipes-summary-card">
                    <div class="card border-0 shadow-lg p-4">
                        <h1 class="display-5 fw-bold mb-2">@Model.Title</h1>
                        <div class="text-muted small mb-2">@Model.Category</div>

                        <div class="d-flex gap-2 flex-wrap mb-3 align-items-center">
                            <span class="badge bg-warning text-dark px-3 py-2">⭐ @Model.AverageScore.ToString("0.0")</span>
                            <span class="badge bg-info px-3 py-2">@Model.Category</span>
                            <span class="badge bg-secondary px-3 py-2">
                                @(Model.Difficulty == DifficultyEnum.Easy ? "⭐ Легкий" : Model.Difficulty == DifficultyEnum.Medium ? "⭐⭐ Середній" : "⭐⭐⭐ Складний")
                            </span>
                        </div>

                        <div class="info-row mt-2">
                            <div class="info-box">
                                <div class="label"><i class="bi bi-clock me-2"></i> Час приготування</div>
                                <div class="value">@Model.CookingTime хвилин</div>
                            </div>

                            <div class="info-box">
                                <div class="label"><i class="bi bi-person me-2"></i> Автор</div>
                                <div class="value">@Model.ChefName</div>
                            </div>
                        </div>

                        <div class="details-actions mt-3 d-flex gap-2 flex-wrap">
                            @if (User.Identity.IsAuthenticated && Model.CanScore)
                            {
                                <a asp-controller="Scores" asp-action="Create" asp-route-recipeId="@Model.Id" class="btn btn-kitchen">
                                    <i class="bi bi-star-fill"></i> Оцінити рецепт
                                </a>
                            }

                            @if (User.Identity.IsAuthenticated && User.FindFirst(ClaimTypes.NameIdentifier)?.Value == Model.ChefId.ToString())
                            {
                                <div class="btn-group" role="group" aria-label="Recipe actions">
                                    @if (Model.Status == StatusRecipeEnum.Draft)
                                    {
                                        <form asp-action="SendToReview" asp-route-id="@Model.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-warning">Відправити на перевірку</button>
                                        </form>
                                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Редагувати</a>
                                    }
                                    @if (Model.Status == StatusRecipeEnum.Checked)
                                    {
                                        <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-success">Опублікувати</button>
                                        </form>
                                    }
                                    @if (Model.Status != StatusRecipeEnum.Published)
                                    {
                                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('Видалити рецепт?')">Видалити</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Grouped panels under the summary: two columns inside the wrapper -->
                <div class="panels-grid mt-3">
                    <div class="panel-col">
                        <div class="panel panel--simple">
                            <div class="panel-header"><i class="bi bi-basket me-2"></i> Інгредієнти</div>
                            <div class="panel-body">@Model.Ingredients</div>
                        </div>
                    </div>

                    <div class="panel-col">
                        <div class="panel panel--simple">
                            <div class="panel-header"><i class="bi bi-file-text me-2"></i> Опис</div>
                            <div class="panel-body" style="overflow-x: hidden; word-break: break-word; max-width: 100%; width: 100%; white-space: normal;">@Model.Description</div>
                        </div>
                    </div>
                </div>
            </div> <!-- /.right-card-wrapper -->
        </div>
    </div>

    <!-- Оцінки журі (full width under grid) -->
    @if (Model.Scores.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 shadow-lg p-4">
                    <h3 class="h5 mb-3"><i class="bi bi-star-fill text-warning me-2"></i> Оцінки журі</h3>
                    <div class="table-responsive">
                        <table class="table table-light table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Суддя</th>
                                    <th>Смак</th>
                                    <th>Подача</th>
                                    <th>Креативність</th>
                                    <th>Загалом</th>
                                    <th>Коментар</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var score in Model.Scores)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(score.JudgeName) ? "Unknown" : score.JudgeName)</td>
                                        <td>@score.Taste/10</td>
                                        <td>@score.Presentation/10</td>
                                        <td>@score.Creativity/10</td>
                                        <td><strong>@score.TotalScore/30</strong></td>
                                        <td>@score.Comments</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }</div>

<style>
  /* General container styles */
  .recipes-page { max-width: 1200px; margin: 0 auto; padding: 0 15px; }
  .recipes-page .btn { border-radius: 10px; }

  /* Two-column details layout */
  .details-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
    margin-top: 24px;
  }
  .details-grid .left-col { }
  .details-grid .right-col { }

  /* Recipe summary card */
  .recipes-summary-card {
    background: var(--clr-white);
    border-radius: 12px;
    padding: 24px;
    box-shadow: var(--shadow-strong);
  }
  .recipes-summary-card h1 {
    font-size: 32px;
    margin-bottom: 16px;
    color: var(--clr-dark);
  }
  .recipes-summary-card .badge { border-radius: 12px; padding: 8px 12px; font-weight: 700; font-size: 13px; }

  /* Image styles */
  .image-wrapper {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    height: 320px;
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 12px;
  }

  /* Info boxes in summary */
  .info-row {
    display: flex;
    gap: 16px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .info-box {
    flex: 1 1 180px;
    min-width: 160px;
    background: var(--clr-white);
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 12px;
    border-radius: 10px;
  }
  .info-box .label {
    color: rgba(0, 0, 0, 0.6);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .info-box .value {
    font-weight: 700;
    color: var(--clr-dark);
    font-size: 15px;
  }

  /* Panels grid (description & ingredients) */
  .panels-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  .panel {
    background: var(--clr-white);
    border-radius: 10px;
    box-shadow: var(--shadow-normal);
  }
  .panel-header {
    background: var(--clr-light);
    padding: 12px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 500;
    color: var(--clr-dark);
  }
  .panel-body {
    padding: 16px;
    color: var(--clr-dark);
  }

  /* Table styles for scores */
  .table {
    width: 100%;
    margin-bottom: 0;
    table-layout: fixed;
  }
  .table th, .table td {
    padding: 12px;
    vertical-align: middle;
  }
  .table th {
    background: var(--clr-light);
    color: var(--clr-dark);
    font-weight: 500;
  }
  .table td {
    background: var(--clr-white);
    color: var(--clr-dark);
  }
</style>