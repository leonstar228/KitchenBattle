@using System.Security.Claims
@model KitchenBattle.ViewModels.RecipeDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Рецепти</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Ліва колонка - фото -->
        <div class="col-md-6 mb-4">
            <div class="card bg-dark border-0 shadow-lg">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-recipe.jpg" : Model.ImageUrl)"
                     class="card-img-top rounded-4" alt="@Model.Title" style="object-fit: cover; height: 400px;">
            </div>
        </div>

        <!-- Права колонка - інформація -->
        <div class="col-md-6">
            <div class="card bg-dark border-0 shadow-lg p-4">
                <h1 class="display-5 fw-bold">@Model.Title</h1>

                <div class="d-flex gap-3 mt-3 mb-4">
                    <span class="badge bg-warning text-dark px-3 py-2">⭐ @Model.AverageScore.ToString("0.0")</span>
                    <span class="badge bg-info px-3 py-2">@Model.Category</span>
                    <span class="badge bg-secondary px-3 py-2">
                        @(Model.Difficulty == DifficultyEnum.Easy ? "⭐ Легкий" : Model.Difficulty == DifficultyEnum.Medium ? "⭐⭐ Середній" : "⭐⭐⭐ Складний")
                    </span>
                </div>

                <div class="mb-4">
                    <h5><i class="bi bi-clock"></i> Час приготування</h5>
                    <p>@Model.CookingTime хвилин</p>
                </div>

                <div class="mb-4">
                    <h5><i class="bi bi-person"></i> Автор</h5>
                    <p>@Model.ChefName</p>
                </div>

                @if (User.Identity.IsAuthenticated && Model.CanScore)
                {
                    <a asp-controller="Scores" asp-action="Create" asp-route-recipeId="@Model.Id" class="btn btn-kitchen mb-3">
                        <i class="bi bi-star-fill"></i> Оцінити рецепт
                    </a>
                }

                @if (User.Identity.IsAuthenticated && @User.FindFirst(ClaimTypes.NameIdentifier)?.Value == Model.ChefId.ToString())
                {
                    <div class="btn-group">
                        @if (Model.Status == StatusRecipeEnum.Draft)
                        {
                            <form asp-action="SendToReview" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning">Відправити на перевірку</button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Редагувати</a>
                        }
                        @if (Model.Status == StatusRecipeEnum.Checked)
                        {
                            <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success">Опублікувати</button>
                            </form>
                        }
                        @if (Model.Status != StatusRecipeEnum.Published)
                        {
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Видалити рецепт?')">Видалити</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Опис та інгредієнти -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card bg-dark border-0 shadow-lg p-4 h-100">
                <h3><i class="bi bi-file-text"></i> Опис</h3>
                <p class="lead">@Model.Description</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-dark border-0 shadow-lg p-4 h-100">
                <h3><i class="bi bi-basket"></i> Інгредієнти</h3>
                <p class="lead">@Model.Ingredients</p>
            </div>
        </div>
    </div>

    <!-- Оцінки -->
    @if (Model.Scores.Any())
    {
        <div class="mt-4">
            <div class="card bg-dark border-0 shadow-lg p-4">
                <h3><i class="bi bi-star-fill text-warning"></i> Оцінки журі</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>Суддя</th>
                                <th>Смак</th>
                                <th>Подача</th>
                                <th>Креативність</th>
                                <th>Загалом</th>
                                <th>Коментар</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var score in Model.Scores)
                            {
                                <tr>
                                    <td>@score.JudgeName</td>
                                    <td>@score.Taste/10</td>
                                    <td>@score.Presentation/10</td>
                                    <td>@score.Creativity/10</td>
                                    <td><strong>@score.TotalScore/30</strong></td>
                                    <td>@score.Comments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Назад до рецептів
        </a>
    </div>
</div>

<style>
    .btn-kitchen {
        background: linear-gradient(135deg, #e65c00, #f9a826);
        color: white;
        border: none;
    }

        .btn-kitchen:hover {
            background: linear-gradient(135deg, #cc5200, #e69500);
            color: white;
        }
</style>