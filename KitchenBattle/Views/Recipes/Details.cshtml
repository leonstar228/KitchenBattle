﻿@using System.Security.Claims
@model KitchenBattle.ViewModels.RecipeDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<div class="container">
    <div class="row g-4 mb-4">
        <!-- Фото -->
        <div class="col-md-6">
            <div class="photo-wrap">
                @if (string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="photo-placeholder">
                        <i class="bi bi-camera"></i>
                        <span>Фото відсутнє</span>
                    </div>
                }
                else
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title">
                }
            </div>
        </div>

        <!-- Інфо -->
        <div class="col-md-6">
            <div class="info-card">
                @* <h1 class="recipe-title-main">@Model.Title</h1> *@

                <h1 class="recipe-title-main">
                    @(Model.Title.Length > 20 ? Model.Title.Substring(0, 20) + "..." : Model.Title)
                </h1>


                <div class="badge-row">
                    <span class="kb-badge badge-score">
                        <i class="bi bi-star-fill" style="color:var(--clr-gold);"></i>
                        @Model.AverageScore.ToString("0.0")
                    </span>
                    <span class="kb-badge badge-category">@Model.Category</span>
                    <span class="kb-badge badge-diff">
                        @(Model.Difficulty == DifficultyEnum.Easy ? "⭐ Легкий"
                                                : Model.Difficulty == DifficultyEnum.Medium ? "⭐⭐ Середній" : "⭐⭐⭐ Складний")
                    </span>
                    <span class="kb-badge badge-status">@Model.Status</span>
                </div>

                <div class="info-row">
                    <div class="info-icon"><i class="bi bi-clock"></i></div>
                    <div>
                        <div class="info-lbl">Час приготування</div>
                        <div class="info-val">@Model.CookingTime хвилин</div>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="bi bi-person-circle"></i></div>
                    <div>
                        <div class="info-lbl">Автор</div>
                        <div class="info-val">@Model.ChefName</div>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="bi bi-star"></i></div>
                    <div>
                        <div class="info-lbl">Оцінок журі</div>
                        <div class="info-val">@Model.Scores.Count</div>
                    </div>
                </div>

                @if (User.Identity.IsAuthenticated && Model.CanScore)
                {
                    <a asp-controller="Scores" asp-action="Create" asp-route-recipeId="@Model.Id"
                           class="btn-score-cta">
                        <i class="bi bi-star-fill"></i> Оцінити рецепт
                    </a>
                }

                @if (User.Identity.IsAuthenticated &&
                     ((User.FindFirst("sub")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) == Model.ChefId))
                {
                    <div class="owner-actions">
                        @if (Model.Status == StatusRecipeEnum.Draft)
                        {
                            <form asp-action="SendToReview" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn-act btn-act-outline">
                                    <i class="bi bi-send"></i> На перевірку
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-act btn-act-gold">
                                <i class="bi bi-pencil"></i> Редагувати
                            </a>
                        }
                        @if (Model.Status == StatusRecipeEnum.Checked)
                        {
                            <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn-act btn-act-outline">
                                    <i class="bi bi-globe"></i> Опублікувати
                                </button>
                            </form>
                        }
                        @if (Model.Status != StatusRecipeEnum.Published)
                        {
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn-act btn-act-danger"
                                        onclick="return confirm('Видалити рецепт?')">
                                    <i class="bi bi-trash"></i> Видалити
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Опис та Інгредієнти -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="section-card">
                <div class="section-title">
                    <i class="bi bi-file-text-fill"></i> Опис
                </div>
                <p class="section-text style="white-space: pre-line;">@Model.Description</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="section-card">
                <div class="section-title">
                    <i class="bi bi-basket-fill"></i> Інгредієнти
                </div>
                <p class="section-text">@Model.Ingredients</p>
            </div>
        </div>
    </div>

    <!-- Оцінки -->
    @if (Model.Scores.Any())
    {
        <div class="scores-wrap">
            <div class="scores-head">
                <h4><i class="bi bi-star-fill" style="color:var(--clr-gold-light);margin-right:8px;"></i>Оцінки журі</h4>
            </div>
            <div class="table-responsive">
                <table class="kb-table">
                    <thead>
                        <tr>
                            <th>Суддя</th>
                            <th>Смак</th>
                            <th>Подача</th>
                            <th>Креативність</th>
                            <th>Загалом</th>
                            <th>Коментар</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var score in Model.Scores)
                        {
                            <tr>
                                <td><strong>@score.JudgeName</strong></td>
                                <td><span class="score-chip">@score.Taste/10</span></td>
                                <td><span class="score-chip">@score.Presentation/10</span></td>
                                <td><span class="score-chip">@score.Creativity/10</span></td>
                                <td><span class="score-chip-total">@score.TotalScore/30</span></td>
                                <td class="comment-text">@score.Comments</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <a asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left"></i> Назад до рецептів
    </a>
</div>