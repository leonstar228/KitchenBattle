@using System.Security.Claims
@model KitchenBattle.ViewModels.RecipeDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --clr-green: #4A6741;
        --clr-green-hover: #6B8F5E;
        --clr-gold: #C47B2B;
        --clr-gold-light: #E8D5A3;
        --clr-ivory: #F5F1E8;
        --clr-white: #FFFFFF;
        --clr-dark: #2C2C2A;
        --clr-brown: #8B7355;
        --clr-red: #D4483B;
        --radius-card: 16px;
        --radius-btn: 6px;
        --radius-pill: 20px;
        --shadow-card: 0 4px 20px rgba(0,0,0,0.08);
        --shadow-hover: 0 8px 30px rgba(0,0,0,0.12);
        --transition: 0.3s ease;
    }

    body {
        background: var(--clr-ivory) !important;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* BREADCRUMB */
    .kb-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 28px 0;
        font-size: 13px;
    }

        .kb-breadcrumb a {
            color: var(--clr-green);
            text-decoration: none;
            font-weight: 600;
        }

            .kb-breadcrumb a:hover {
                text-decoration: underline;
            }

        .kb-breadcrumb span {
            color: var(--clr-brown);
        }

    /* PHOTO */
    .photo-wrap {
        border-radius: var(--radius-card);
        overflow: hidden;
        box-shadow: var(--shadow-card);
        animation: slideUp .45s ease both;
    }

        .photo-wrap img {
            width: 100%;
            height: 370px;
            object-fit: cover;
            display: block;
        }

    /* Placeholder */
    .photo-placeholder {
        width: 100%;
        height: 370px;
        background: linear-gradient(135deg, var(--clr-green), var(--clr-green-hover));
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

        .photo-placeholder i {
            font-size: 72px;
            color: rgba(255,255,255,0.3);
        }

        .photo-placeholder span {
            font-size: 13px;
            color: rgba(255,255,255,0.25);
            text-transform: uppercase;
            letter-spacing: .06em;
        }


    /* INFO CARD */
    .info-card {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        padding: 28px;
        height: 100%;
        display: flex;
        flex-direction: column;
        animation: slideUp .45s .08s ease both;
    }

    .recipe-title-main {
        font-family: 'Biryani', sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--clr-dark);
        margin-bottom: 16px;
        line-height: 1.25;
    }

    .badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
    }

    .kb-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 13px;
        border-radius: var(--radius-pill);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .03em;
    }

    .badge-score {
        background: var(--clr-gold-light);
        color: var(--clr-dark);
    }

    .badge-category {
        background: rgba(74,103,65,.1);
        color: var(--clr-green);
    }

    .badge-diff {
        background: rgba(139,115,85,.1);
        color: var(--clr-brown);
    }

    .badge-status {
        background: rgba(74,103,65,.1);
        color: var(--clr-green);
    }

    .info-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid var(--clr-gold-light);
    }

        .info-row:last-of-type {
            border-bottom: none;
        }

    .info-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(74,103,65,.1);
        color: var(--clr-green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .info-lbl {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: var(--clr-brown);
    }

    .info-val {
        font-size: 14px;
        font-weight: 600;
        color: var(--clr-dark);
    }

    /* CTA BUTTON */
    .btn-score-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--clr-gold);
        color: var(--clr-white);
        border: none;
        border-radius: var(--radius-btn);
        padding: 12px 24px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        margin-top: 20px;
        transition: var(--transition);
        letter-spacing: .04em;
        text-transform: uppercase;
    }

        .btn-score-cta:hover {
            background: #b36520;
            color: var(--clr-white);
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(196,123,43,.35);
        }

    /* OWNER ACTIONS */
    .owner-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
    }

    .btn-act {
        border: none;
        border-radius: var(--radius-btn);
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: var(--transition);
    }

    .btn-act-outline {
        border: 1.5px solid var(--clr-green);
        background: transparent;
        color: var(--clr-green);
    }

        .btn-act-outline:hover {
            background: rgba(74,103,65,.08);
        }

    .btn-act-gold {
        background: var(--clr-gold-light);
        color: var(--clr-dark);
    }

        .btn-act-gold:hover {
            background: #d4b87a;
        }

    .btn-act-danger {
        background: rgba(212,72,59,.1);
        color: var(--clr-red);
    }

        .btn-act-danger:hover {
            background: rgba(212,72,59,.2);
        }

    /* SECTION CARDS */
    .section-card {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        padding: 26px;
        height: 100%;
        animation: slideUp .45s .16s ease both;
    }

    .section-title {
        font-family: 'Biryani', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: var(--clr-dark);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .section-title i {
            color: var(--clr-green);
        }

    .section-text {
        font-size: 14px;
        color: #555;
        line-height: 1.7;
    }

    /* SCORES CARD */
    .scores-wrap {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        margin-top: 28px;
        animation: slideUp .45s .24s ease both;
    }

    .scores-head {
        background: var(--clr-green);
        padding: 16px 24px;
        position: relative;
        overflow: hidden;
    }

        .scores-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(45deg,transparent,transparent 12px,rgba(255,255,255,.03) 12px,rgba(255,255,255,.03) 24px);
        }

        .scores-head h4 {
            font-family: 'Biryani',sans-serif;
            font-size: 17px;
            font-weight: 700;
            color: var(--clr-white);
            margin: 0;
            position: relative;
            z-index: 1;
        }

    .kb-table {
        width: 100%;
        border-collapse: collapse;
    }

        .kb-table thead th {
            background: #FDFBF7;
            color: var(--clr-brown);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .07em;
            padding: 12px 16px;
            border-bottom: 2px solid var(--clr-gold-light);
            text-align: left;
        }

        .kb-table tbody td {
            padding: 13px 16px;
            color: var(--clr-dark);
            font-size: 14px;
            border-bottom: 1px solid rgba(0,0,0,.04);
            vertical-align: middle;
        }

        .kb-table tbody tr:last-child td {
            border-bottom: none;
        }

        .kb-table tbody tr:hover td {
            background: #FEFCF8;
        }

    .score-chip {
        background: var(--clr-gold-light);
        color: var(--clr-dark);
        border-radius: var(--radius-pill);
        padding: 3px 10px;
        font-size: 12px;
        font-weight: 700;
    }

    .score-chip-total {
        background: var(--clr-green);
        color: var(--clr-white);
        border-radius: var(--radius-pill);
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 700;
    }

    .comment-text {
        color: var(--clr-brown);
        font-style: italic;
    }

    /* BACK LINK */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--clr-brown);
        text-decoration: none;
        border: 1.5px solid var(--clr-gold-light);
        border-radius: var(--radius-pill);
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 500;
        transition: var(--transition);
        margin-top: 28px;
    }

        .btn-back:hover {
            border-color: var(--clr-green);
            color: var(--clr-green);
        }
</style>

<div class="container">
    <div class="row g-4 mb-4">
        <!-- Фото -->
        <div class="col-md-6">
            <div class="photo-wrap">
                @if (string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="photo-placeholder">
                        <i class="bi bi-camera"></i>
                        <span>Фото відсутнє</span>
                    </div>
                }
                else
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title">
                }
            </div>
        </div>

        <!-- Інфо -->
        <div class="col-md-6">
            <div class="info-card">
                <h1 class="recipe-title-main">@Model.Title</h1>

                <div class="badge-row">
                    <span class="kb-badge badge-score">
                        <i class="bi bi-star-fill" style="color:var(--clr-gold);"></i>
                        @Model.AverageScore.ToString("0.0")
                    </span>
                    <span class="kb-badge badge-category">@Model.Category</span>
                    <span class="kb-badge badge-diff">
                        @(Model.Difficulty == DifficultyEnum.Easy ? "⭐ Легкий"
                                                : Model.Difficulty == DifficultyEnum.Medium ? "⭐⭐ Середній" : "⭐⭐⭐ Складний")
                    </span>
                    <span class="kb-badge badge-status">@Model.Status</span>
                </div>

                <div class="info-row">
                    <div class="info-icon"><i class="bi bi-clock"></i></div>
                    <div>
                        <div class="info-lbl">Час приготування</div>
                        <div class="info-val">@Model.CookingTime хвилин</div>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="bi bi-person-circle"></i></div>
                    <div>
                        <div class="info-lbl">Автор</div>
                        <div class="info-val">@Model.ChefName</div>
                    </div>
                </div>
                <div class="info-row">
                    <div class="info-icon"><i class="bi bi-star"></i></div>
                    <div>
                        <div class="info-lbl">Оцінок журі</div>
                        <div class="info-val">@Model.Scores.Count</div>
                    </div>
                </div>

                @if (User.Identity.IsAuthenticated && Model.CanScore)
                {
                    <a asp-controller="Scores" asp-action="Create" asp-route-recipeId="@Model.Id"
                       class="btn-score-cta">
                        <i class="bi bi-star-fill"></i> Оцінити рецепт
                    </a>
                }

                @if (User.Identity.IsAuthenticated &&
                                User.FindFirst(ClaimTypes.NameIdentifier)?.Value == Model.ChefId.ToString())
                {
                    <div class="owner-actions">
                        @if (Model.Status == StatusRecipeEnum.Draft)
                        {
                            <form asp-action="SendToReview" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn-act btn-act-outline">
                                    <i class="bi bi-send"></i> На перевірку
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-act btn-act-gold">
                                <i class="bi bi-pencil"></i> Редагувати
                            </a>
                        }
                        @if (Model.Status == StatusRecipeEnum.Checked)
                        {
                            <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn-act btn-act-outline">
                                    <i class="bi bi-globe"></i> Опублікувати
                                </button>
                            </form>
                        }
                        @if (Model.Status != StatusRecipeEnum.Published)
                        {
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn-act btn-act-danger"
                                        onclick="return confirm('Видалити рецепт?')">
                                    <i class="bi bi-trash"></i> Видалити
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Опис та Інгредієнти -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="section-card">
                <div class="section-title">
                    <i class="bi bi-file-text-fill"></i> Опис
                </div>
                <p class="section-text">@Model.Description</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="section-card">
                <div class="section-title">
                    <i class="bi bi-basket-fill"></i> Інгредієнти
                </div>
                <p class="section-text">@Model.Ingredients</p>
            </div>
        </div>
    </div>

    <!-- Оцінки -->
    @if (Model.Scores.Any())
    {
        <div class="scores-wrap">
            <div class="scores-head">
                <h4><i class="bi bi-star-fill" style="color:var(--clr-gold-light);margin-right:8px;"></i>Оцінки журі</h4>
            </div>
            <div class="table-responsive">
                <table class="kb-table">
                    <thead>
                        <tr>
                            <th>Суддя</th>
                            <th>Смак</th>
                            <th>Подача</th>
                            <th>Креативність</th>
                            <th>Загалом</th>
                            <th>Коментар</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var score in Model.Scores)
                        {
                            <tr>
                                <td><strong>@score.JudgeName</strong></td>
                                <td><span class="score-chip">@score.Taste/10</span></td>
                                <td><span class="score-chip">@score.Presentation/10</span></td>
                                <td><span class="score-chip">@score.Creativity/10</span></td>
                                <td><span class="score-chip-total">@score.TotalScore/30</span></td>
                                <td class="comment-text">@score.Comments</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <a asp-action="Index" class="btn-back">
        <i class="bi bi-arrow-left"></i> Назад до рецептів
    </a>
</div>
