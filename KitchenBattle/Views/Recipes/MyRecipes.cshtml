@model IEnumerable<KitchenBattle.Models.Recipe>
@{
    ViewData["Title"] = "Мої рецепти";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --clr-green: #4A6741;
        --clr-green-hover: #6B8F5E;
        --clr-gold: #C47B2B;
        --clr-gold-light: #E8D5A3;
        --clr-ivory: #F5F1E8;
        --clr-white: #FFFFFF;
        --clr-dark: #2C2C2A;
        --clr-brown: #8B7355;
        --clr-red: #D4483B;
        --radius-card: 16px;
        --radius-btn: 6px;
        --radius-pill: 20px;
        --shadow-card: 0 4px 20px rgba(0,0,0,0.08);
        --transition: 0.3s ease;
    }

    body { background: var(--clr-ivory) !important; }

    @@keyframes fadeDown {
        from { opacity: 0; transform: translateY(-14px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .page-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 14px;
        padding: 36px 0 28px;
        animation: fadeDown .5s ease both;
    }

    .page-top h1 {
        font-family: 'Biryani', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: var(--clr-dark);
        margin: 0;
    }

    .page-top p { color: var(--clr-brown); font-size: 14px; margin: 4px 0 0; }

    .btn-new {
        background: var(--clr-gold);
        color: var(--clr-white);
        border: none;
        border-radius: var(--radius-btn);
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: var(--transition);
        white-space: nowrap;
    }

    .btn-new:hover {
        background: #b36520;
        color: var(--clr-white);
        transform: translateY(-2px);
    }

    /* ALERTS */
    .alert-kb {
        border-radius: var(--radius-btn);
        padding: 12px 16px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 500;
        animation: fadeDown .4s ease both;
    }

    .alert-success-kb { background: rgba(74,103,65,.1); border: 1px solid rgba(74,103,65,.3); color: var(--clr-green); }
    .alert-error-kb   { background: rgba(212,72,59,.08); border: 1px solid rgba(212,72,59,.25); color: var(--clr-red); }

    /* TABLE */
    .table-wrap {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        margin-bottom: 48px;
        animation: slideUp .5s ease both;
    }

    .kb-table {
        width: 100%;
        border-collapse: collapse;
    }

    .kb-table thead th {
        background: #FDFBF7;
        color: var(--clr-brown);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        padding: 14px 16px;
        border-bottom: 2px solid var(--clr-gold-light);
        text-align: left;
    }

    .kb-table tbody td {
        padding: 14px 16px;
        color: var(--clr-dark);
        font-size: 14px;
        border-bottom: 1px solid rgba(0,0,0,.04);
        vertical-align: middle;
    }

    .kb-table tbody tr:last-child td { border-bottom: none; }

    .kb-table tbody tr { transition: var(--transition); }

    .kb-table tbody tr:hover td { background: #FEFCF8; }

    /* Thumbnail */
    .thumb-placeholder {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, var(--clr-green), var(--clr-green-hover));
        border-radius: 10px;
        border: 2px solid var(--clr-gold-light);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .thumb-placeholder i { font-size: 18px; color: rgba(255,255,255,0.5); }

    .recipe-thumb {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 10px;
        border: 2px solid var(--clr-gold-light);
    }

    .recipe-link {
        font-family: 'Biryani', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: var(--clr-dark);
        text-decoration: none;
    }

    .recipe-link:hover { color: var(--clr-green); }

    .recipe-sub { font-size: 12px; color: var(--clr-brown); margin-top: 2px; }

    /* STATUS PILLS */
    .s-pill {
        display: inline-block;
        border-radius: var(--radius-pill);
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
    }

    .s-Draft     { background: rgba(139,115,85,.12); color: var(--clr-brown); }
    .s-Checked   { background: rgba(196,123,43,.15); color: var(--clr-gold); }
    .s-Published { background: rgba(74,103,65,.13);  color: var(--clr-green); }
    .s-Rejected  { background: rgba(212,72,59,.12);  color: var(--clr-red); }

    .rating-val { color: var(--clr-gold); font-weight: 700; }
    .rating-cnt { color: var(--clr-brown); font-size: 11px; text-decoration: underline; }

    /* ACTION BUTTONS */
    .ab {
        border: none;
        border-radius: var(--radius-btn);
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: var(--transition);
        margin: 2px;
    }

    .ab-view  { background: rgba(74,103,65,.1);  color: var(--clr-green); }
    .ab-view:hover  { background: rgba(74,103,65,.2);  color: var(--clr-green); }

    .ab-edit  { background: rgba(196,123,43,.12); color: var(--clr-gold); }
    .ab-edit:hover  { background: rgba(196,123,43,.22); color: var(--clr-gold); }

    .ab-send  { background: rgba(74,103,65,.1);  color: var(--clr-green); }
    .ab-send:hover  { background: rgba(74,103,65,.2);  color: var(--clr-green); }

    .ab-del   { background: rgba(212,72,59,.1);  color: var(--clr-red); }
    .ab-del:hover   { background: rgba(212,72,59,.2);  color: var(--clr-red); }

    /* REJECTION REASON ROW */
    .rejection-row td {
        padding: 0 16px 14px !important;
        border-bottom: 1px solid rgba(0,0,0,.04);
    }

    .rejection-box {
        background: rgba(212,72,59,.06);
        border: 1px solid rgba(212,72,59,.2);
        border-left: 4px solid var(--clr-red);
        border-radius: 0 var(--radius-btn) var(--radius-btn) 0;
        padding: 10px 14px;
        font-size: 13px;
        color: var(--clr-dark);
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .rejection-box i { color: var(--clr-red); flex-shrink: 0; margin-top: 1px; }
    .rejection-box span { line-height: 1.5; }

    /* MODERATION INFO BADGE */
    .moderation-note {
        background: rgba(196,123,43,.1);
        border: 1px solid rgba(196,123,43,.25);
        border-radius: var(--radius-btn);
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #7a5a1e;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* EMPTY */
    .empty-state {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        text-align: center;
        padding: 80px 24px;
        animation: slideUp .5s ease both;
    }

    .empty-icon { font-size: 56px; color: var(--clr-gold-light); margin-bottom: 14px; }

    .empty-state h3 { font-family: 'Biryani', sans-serif; font-weight: 700; color: var(--clr-green); }
    .empty-state p  { color: var(--clr-brown); }
</style>

<div class="container">
    <div class="page-top">
        <div>
            <h1>👨‍🍳 Мої рецепти</h1>
            <p>Керуйте своїми кулінарними шедеврами</p>
        </div>
        <a asp-action="Create" class="btn-new">
            <i class="bi bi-plus-circle"></i> Новий рецепт
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-kb alert-success-kb">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-kb alert-error-kb">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-journal-plus"></i></div>
            <h3>У вас ще немає рецептів</h3>
            <p>Створіть свій перший рецепт прямо зараз!</p>
            <a asp-action="Create" class="btn-new" style="margin-top:16px;">
                <i class="bi bi-plus-circle"></i> Створити рецепт
            </a>
        </div>
    }
    else
    {
        <div class="moderation-note">
            <i class="bi bi-info-circle-fill"></i>
            Після надсилання на перевірку рецепт розглядається адміністратором. Публікація відбувається лише після схвалення.
        </div>

        <div class="table-wrap">
            <div class="table-responsive">
                <table class="kb-table">
                    <thead>
                        <tr>
                            <th>Фото</th>
                            <th>Назва</th>
                            <th>Категорія</th>
                            <th>Рейтинг</th>
                            <th>Статус</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recipe in Model)
                        {
                            <tr>
                                <td>
                                    @if (string.IsNullOrEmpty(recipe.ImageUrl))
                                    {
                                        <div class="thumb-placeholder"><i class="bi bi-camera"></i></div>
                                    }
                                    else
                                    {
                                        <img src="@recipe.ImageUrl" class="recipe-thumb" alt="@recipe.Title">
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@recipe.Id" class="recipe-link">
                                        @recipe.Title
                                    </a>
                                    <div class="recipe-sub">
                                        <i class="bi bi-clock"></i> @recipe.CookingTime хв
                                        &nbsp;·&nbsp;
                                        <i class="bi bi-bar-chart"></i> @recipe.Difficulty
                                    </div>
                                </td>
                                <td style="color:var(--clr-brown);font-size:13px;">@recipe.Category</td>
                                <td>
                                    ★ <span class="rating-val">@recipe.AverageScore.ToString("0.0")</span>
                                    <span class="rating-cnt">(@recipe.Scores.Count)</span>
                                </td>
                                <td>
                                    <span class="s-pill s-@recipe.Status.ToString()">
                                        @(recipe.Status == StatusRecipeEnum.Draft ? "Чернетка" :
                                          recipe.Status == StatusRecipeEnum.Checked ? "На перевірці" :
                                          recipe.Status == StatusRecipeEnum.Published ? "Опубліковано" :
                                          "Відхилено")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@recipe.Id" class="ab ab-view" title="Переглянути">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (recipe.Status == StatusRecipeEnum.Draft || recipe.Status == StatusRecipeEnum.Rejected)
                                    {
                                        <a asp-action="Edit" asp-route-id="@recipe.Id" class="ab ab-edit" title="Редагувати">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (recipe.Status == StatusRecipeEnum.Draft)
                                    {
                                        <form asp-action="SendToReview" asp-route-id="@recipe.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ab ab-send" title="Надіслати на перевірку"
                                                    onclick="return confirm('Надіслати рецепт на перевірку адміністратору?')">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (recipe.Status == StatusRecipeEnum.Rejected)
                                    {
                                        <form asp-action="SendToReview" asp-route-id="@recipe.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ab ab-send" title="Надіслати повторно"
                                                    onclick="return confirm('Надіслати виправлений рецепт на повторну перевірку?')">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (recipe.Status != StatusRecipeEnum.Published && recipe.Status != StatusRecipeEnum.Checked)
                                    {
                                        <a asp-action="Delete" asp-route-id="@recipe.Id" class="ab ab-del" title="Видалити">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>

                            @* Показуємо причину відхилення якщо є *@
                            @if (recipe.Status == StatusRecipeEnum.Rejected && !string.IsNullOrWhiteSpace(recipe.RejectionReason))
                            {
                                <tr class="rejection-row">
                                    <td colspan="6">
                                        <div class="rejection-box">
                                            <i class="bi bi-chat-left-text-fill"></i>
                                            <span>
                                                <strong>Коментар адміністратора:</strong> @recipe.RejectionReason
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>