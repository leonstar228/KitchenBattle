@model IEnumerable<KitchenBattle.Models.Recipe>
@{
    ViewData["Title"] = "Мої рецепти";
}

<div class="container py-5">
    <div class="page-header-centered">
        <h1 class="display-5 fw-bold">👨‍🍳 Мої рецепти</h1>
        <p class="lead">Керуйте своїми кулінарними шедеврами</p>
    </div>

    <div class="mb-4">
        <a asp-action="Create" class="btn-new">
            <i class="bi bi-plus-circle"></i> Новий рецепт
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-journal-plus"></i></div>
            <h3>У вас ще немає рецептів</h3>
            <p>Створіть свій перший рецепт прямо зараз!</p>
            <a asp-action="Create" class="btn-new" style="margin-top:16px;">
                <i class="bi bi-plus-circle"></i> Створити рецепт
            </a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <div class="table-responsive">
                <table class="kb-table">
                    <thead>
                        <tr>
                            <th>Фото</th>
                            <th>Назва</th>
                            <th>Категорія</th>
                            <th>Рейтинг</th>
                            <th>Статус</th>
                            <th>Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recipe in Model)
                        {
                            <tr>
                                <td>
                                    @if (string.IsNullOrEmpty(recipe.ImageUrl))
                                    {
                                        <div class="thumb-placeholder"><i class="bi bi-camera"></i></div>
                                    }
                                    else
                                    {
                                        <img src="@recipe.ImageUrl" class="recipe-thumb" alt="@recipe.Title">
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@recipe.Id" class="recipe-link">
                                        @recipe.Title
                                    </a>
                                    <div class="recipe-sub">
                                        <i class="bi bi-clock"></i> @recipe.CookingTime хв
                                        &nbsp;·&nbsp;
                                        <i class="bi bi-bar-chart"></i> @recipe.Difficulty
                                    </div>
                                </td>
                                <td style="color:var(--clr-brown);font-size:13px;">
                                    @recipe.Category
                                </td>
                                <td>
                                    ★ <span class="rating-val">@recipe.AverageScore.ToString("0.0")</span>
                                    <span class="rating-cnt">(@recipe.Scores.Count)</span>
                                </td>
                                <td>
                                    <span class="s-pill s-@recipe.Status.ToString()">
                                        @recipe.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@recipe.Id" class="ab ab-view">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (recipe.Status == StatusRecipeEnum.Draft || recipe.Status == StatusRecipeEnum.Rejected)
                                    {
                                        <a asp-action="Edit" asp-route-id="@recipe.Id" class="ab ab-edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (recipe.Status == StatusRecipeEnum.Draft)
                                    {
                                        <form asp-action="SendToReview" asp-route-id="@recipe.Id" method="post" class="d-inline">
                                            <button type="submit" class="ab ab-send"
                                                    onclick="return confirm('Відправити на перевірку?')">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (recipe.Status == StatusRecipeEnum.Checked)
                                    {
                                        <form asp-action="Publish" asp-route-id="@recipe.Id" method="post" class="d-inline">
                                            <button type="submit" class="ab ab-pub"
                                                    onclick="return confirm('Опублікувати рецепт?')">
                                                <i class="bi bi-globe"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (recipe.Status != StatusRecipeEnum.Published)
                                    {
                                        <a asp-action="Delete" asp-route-id="@recipe.Id" class="ab ab-del">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>