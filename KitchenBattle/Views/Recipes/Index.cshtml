@model IEnumerable<KitchenBattle.Models.Recipe>
@{
    ViewData["Title"] = "Рецепти";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<div class="container">
    <div class="rp-header">
        <h1>🍳 Кулінарні рецепти</h1>
        <p>Найкращі страви від наших шеф-кухарів</p>
    </div>

    <!-- ФІЛЬТРИ -->
    <div class="filter-bar">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="filter-lbl">Пошук</label>
                <input type="text" name="search" class="filter-ctrl"
                       placeholder="Пошук за назвою…" value="@ViewBag.CurrentSearch">
            </div>
            <div class="col-md-3">
                <label class="filter-lbl">Складність</label>
                <select name="difficulty" class="filter-ctrl">
                    <option value="">Вся складність</option>
                    <option value="Easy" selected="@(ViewBag.CurrentDifficulty?.ToString() == "Easy")">⭐ Легкий</option>
                    <option value="Medium" selected="@(ViewBag.CurrentDifficulty?.ToString() == "Medium")">⭐⭐ Середній</option>
                    <option value="Hard" selected="@(ViewBag.CurrentDifficulty?.ToString() == "Hard")">⭐⭐⭐ Складний</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="filter-lbl">Категорія</label>
                <select name="category" class="filter-ctrl">
                    <option value="">Всі категорії</option>
                    @foreach (var cat in Enum.GetValues<CategoryEnum>())
                    {
                        <option value="@cat" selected="@(ViewBag.CurrentCategory?.ToString() == cat.ToString())">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="filter-lbl" style="opacity:0;">.</label>
                <button type="submit" class="btn-filter">
                    <i class="bi bi-search"></i> Знайти
                </button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
            <h3>Рецептів не знайдено</h3>
            <p>Спробуйте змінити параметри пошуку</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var recipe in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="recipe-card">
                        <div class="position-relative">
                            @if (string.IsNullOrEmpty(recipe.ImageUrl))
                            {
                                <div class="img-placeholder">
                                    <i class="bi bi-camera"></i>
                                    <span>Фото відсутнє</span>
                                </div>
                            }
                            else
                            {
                                <img src="@recipe.ImageUrl" class="card-img-top-kb" alt="@recipe.Title">
                            }
                            <span class="diff-badge diff-@recipe.Difficulty.ToString()">
                                @(recipe.Difficulty == DifficultyEnum.Easy ? "Легкий"
                                        : recipe.Difficulty == DifficultyEnum.Medium ? "Середній" : "Складний")
                            </span>
                        </div>
                        <div class="card-body-kb">
                            <span class="cat-pill">@recipe.Category</span>
                            <div class="card-title-kb">@recipe.Title</div>
                            <div class="card-chef"><i class="bi bi-person-fill"></i> @recipe.ChefName</div>
                            <div class="card-desc">
                                @(recipe.Description.Length > 90
                                        ? recipe.Description.Substring(0, 90) + "…"
                                        : recipe.Description)
                            </div>
                            <div class="card-meta">
                                <span>
                                    <span class="rating-stars">
                                        ★ @recipe.AverageScore.ToString("0.0")
                                    </span>
                                    <span class="rating-cnt">(@recipe.Scores.Count)</span>
                                </span>
                                <span class="cook-time">
                                    <i class="bi bi-clock"></i> @recipe.CookingTime хв
                                </span>
                            </div>
                        </div>
                        <div class="card-footer-kb">
                            <a asp-action="Details" asp-route-id="@recipe.Id" class="btn-details">
                                <i class="bi bi-eye"></i> Деталі
                            </a>
                            @if (User.IsInRole("judge"))
                            {
                                <a asp-controller="Scores" asp-action="Create"
                                   asp-route-recipeId="@recipe.Id" class="btn-rate">
                                    <i class="bi bi-star"></i> Оцінити
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>