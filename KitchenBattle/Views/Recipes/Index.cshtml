@model IEnumerable<KitchenBattle.Models.Recipe>
@{
    ViewData["Title"] = "Рецепти";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-4">🍳 Кулінарні рецепти</h1>
        <p class="lead text-muted">Найкращі страви від наших шеф-кухарів</p>
        @if (User.Identity.IsAuthenticated && User.IsInRole("Chef"))
        {
            <a asp-action="Create" class="btn btn-kitchen mt-3">
                <i class="bi bi-plus-circle"></i> Додати рецепт
            </a>
        }
    </div>

    <!-- Фільтри -->
    <div class="card bg-dark border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control bg-secondary text-white border-0"
                           placeholder="Пошук за назвою..." value="@ViewBag.CurrentSearch">
                </div>
                <div class="col-md-3">
                    <select name="difficulty" class="form-select bg-secondary text-white border-0">
                        <option value="">Вся складність</option>
                        <option value="Easy" selected="@(ViewBag.CurrentDifficulty?.ToString() == "Easy")">⭐ Легкий</option>
                        <option value="Medium" selected="@(ViewBag.CurrentDifficulty?.ToString() == "Medium")">⭐⭐ Середній</option>
                        <option value="Hard" selected="@(ViewBag.CurrentDifficulty?.ToString() == "Hard")">⭐⭐⭐ Складний</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="category" class="form-select bg-secondary text-white border-0">
                        <option value="">Всі категорії</option>
                        @foreach (var cat in Enum.GetValues<CategoryEnum>())
                        {
                            <option value="@cat" selected="@(ViewBag.CurrentCategory?.ToString() == cat.ToString())">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-kitchen w-100">Фільтрувати</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Сітка рецептів -->
    <div class="row g-4">
        @foreach (var recipe in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card recipe-card h-100">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(recipe.ImageUrl) ? "/images/default-recipe.jpg" : recipe.ImageUrl)"
                             class="card-img-top" alt="@recipe.Title" style="height: 220px; object-fit: cover;">
                        <div class="recipe-badge position-absolute top-0 end-0 m-2">
                            <span class="badge bg-kitchen">@recipe.Difficulty</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@recipe.Title</h5>
                        <p class="card-text text-muted small">👨‍🍳 @recipe.ChefName</p>
                        <p class="card-text">@(recipe.Description.Length > 100 ? recipe.Description.Substring(0, 100) + "..." : recipe.Description)</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="rating">
                                ⭐ <strong>@recipe.AverageScore.ToString("0.0")</strong>
                                <span class="text-muted">(@recipe.Scores.Count)</span>
                            </div>
                            <span class="badge bg-info">@recipe.Category</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-outline-kitchen w-100">
                            Детальніше <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown fs-1 text-muted"></i>
            <h3 class="text-muted mt-3">Рецептів не знайдено</h3>
            <p>Спробуйте змінити параметри пошуку</p>
        </div>
    }
</div>

<style>
    .recipe-card {
        background: #1a1a2e;
        border: none;
        border-radius: 16px;
        transition: transform 0.3s, box-shadow 0.3s;
        overflow: hidden;
    }
    .recipe-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .btn-kitchen {
        background: linear-gradient(135deg, #e65c00, #f9a826);
        color: white;
        border: none;
    }
    .btn-kitchen:hover {
        background: linear-gradient(135deg, #cc5200, #e69500);
        color: white;
    }
    .btn-outline-kitchen {
        border: 1px solid #e65c00;
        color: #e65c00;
    }
    .btn-outline-kitchen:hover {
        background: #e65c00;
        color: white;
    }
    .badge-kitchen {
        background: #e65c00;
    }
    .rating {
        color: #f9a826;
    }
</style>