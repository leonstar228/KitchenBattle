@model List<KitchenBattle.ViewModels.ScoreDisplayViewModel>
@{
    ViewData["Title"] = "Оцінки рецепта";
    int recipeId = ViewBag.RecipeId;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold">⭐ Оцінки журі</h1>
            <p class="text-muted">Всі оцінки та коментарі до рецепта</p>
        </div>
        <a asp-action="Details" asp-route-id="@recipeId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Назад до рецепта
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-star fs-1 text-muted"></i>
            <h3 class="text-muted mt-3">Ще немає оцінок</h3>
            <p>Будьте першим, хто оцінить цей рецепт!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var score in Model)
            {
                <div class="col-md-6">
                    <div class="card bg-dark border-0 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="fw-bold">👨‍⚖️ @score.JudgeName</h5>
                                <span class="badge bg-kitchen">@score.TotalScore/30</span>
                            </div>

                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <div class="bg-secondary bg-opacity-25 rounded p-2">
                                        <small class="text-muted">Смак</small>
                                        <h4 class="mb-0 text-warning">@score.Taste/10</h4>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-secondary bg-opacity-25 rounded p-2">
                                        <small class="text-muted">Подача</small>
                                        <h4 class="mb-0 text-info">@score.Presentation/10</h4>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-secondary bg-opacity-25 rounded p-2">
                                        <small class="text-muted">Креативність</small>
                                        <h4 class="mb-0 text-success">@score.Creativity/10</h4>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(score.Comments))
                            {
                                <div class="mt-3">
                                    <small class="text-muted"><i class="bi bi-chat"></i> Коментар:</small>
                                    <p class="mb-0">@score.Comments</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 text-center">
            <div class="card bg-dark border-0 shadow-lg d-inline-block">
                <div class="card-body">
                    <h5 class="mb-0">Середня оцінка: <strong class="text-warning">@Model.Average(s => s.TotalScore).ToString("0.0")/30</strong></h5>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .bg-kitchen {
        background: linear-gradient(135deg, #e65c00, #f9a826);
    }
</style>