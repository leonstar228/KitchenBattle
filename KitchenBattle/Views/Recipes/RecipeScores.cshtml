@model List<KitchenBattle.ViewModels.ScoreDisplayViewModel>
@{
    ViewData["Title"] = "Оцінки рецепта";
    int recipeId = ViewBag.RecipeId;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --clr-green: #4A6741;
        --clr-green-hover: #6B8F5E;
        --clr-gold: #C47B2B;
        --clr-gold-light: #E8D5A3;
        --clr-ivory: #F5F1E8;
        --clr-white: #FFFFFF;
        --clr-dark: #2C2C2A;
        --clr-brown: #8B7355;
        --clr-red: #D4483B;
        --radius-card: 16px;
        --radius-btn: 6px;
        --radius-pill: 20px;
        --shadow-card: 0 4px 20px rgba(0,0,0,0.08);
        --shadow-hover: 0 8px 30px rgba(0,0,0,0.12);
        --transition: 0.3s ease;
    }

    body {
        background: var(--clr-ivory) !important;
    }

    @@keyframes fadeDown {
        from {
            opacity: 0;
            transform: translateY(-14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* PAGE TOP */
    .page-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        padding: 36px 0 28px;
        animation: fadeDown .5s ease both;
    }

    .page-title {
        font-family: 'Biryani',sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: var(--clr-dark);
        margin: 0;
    }

    .page-sub {
        color: var(--clr-brown);
        font-size: 13px;
        font-style: italic;
        margin-top: 4px;
    }

    .btn-primary-kb {
        background: var(--clr-gold);
        color: var(--clr-white);
        border: none;
        border-radius: var(--radius-btn);
        padding: 10px 22px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: .04em;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition);
    }

        .btn-primary-kb:hover {
            background: #b36520;
            color: var(--clr-white);
            transform: translateY(-1px);
        }

    .btn-outline-kb {
        background: transparent;
        color: var(--clr-brown);
        border: 1.5px solid #C8C0B4;
        border-radius: var(--radius-btn);
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition);
    }

        .btn-outline-kb:hover {
            border-color: var(--clr-green);
            color: var(--clr-green);
        }

    /* SUMMARY BAR */
    .summary-bar {
        background: var(--clr-green);
        border-radius: var(--radius-card);
        padding: 22px 32px;
        margin-bottom: 32px;
        display: flex;
        gap: 28px;
        align-items: center;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
        animation: slideUp .45s ease both;
    }

        .summary-bar::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(45deg,transparent,transparent 14px,rgba(255,255,255,.03) 14px,rgba(255,255,255,.03) 28px);
        }

    .sum-stat {
        position: relative;
        z-index: 1;
    }

    .sum-val {
        font-family: 'Biryani',sans-serif;
        font-size: 26px;
        font-weight: 800;
        color: var(--clr-white);
        line-height: 1;
    }

    .sum-lbl {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: rgba(255,255,255,.55);
        margin-top: 3px;
    }

    .sum-div {
        width: 1px;
        height: 32px;
        background: rgba(255,255,255,.2);
        position: relative;
        z-index: 1;
    }

    /* SCORE CARDS */
    .score-card {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform var(--transition), box-shadow var(--transition);
        animation: cardIn .4s ease both;
    }

        .score-card:nth-child(1) {
            animation-delay: .05s
        }

        .score-card:nth-child(2) {
            animation-delay: .12s
        }

        .score-card:nth-child(3) {
            animation-delay: .19s
        }

        .score-card:nth-child(4) {
            animation-delay: .26s
        }

        .score-card:nth-child(5) {
            animation-delay: .33s
        }

        .score-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

    .card-accent {
        height: 4px;
        background: linear-gradient(to right,var(--clr-green),var(--clr-gold));
    }

    .card-body-inner {
        padding: 20px 22px;
        flex: 1;
    }

    .judge-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .judge-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--clr-green);
        color: var(--clr-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .judge-name {
        font-family: 'Biryani',sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: var(--clr-dark);
        margin: 0;
    }

    .judge-role {
        font-size: 11px;
        color: var(--clr-brown);
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .total-badge {
        background: var(--clr-gold);
        color: var(--clr-white);
        border-radius: var(--radius-pill);
        padding: 5px 14px;
        font-family: 'Biryani',sans-serif;
        font-size: 14px;
        font-weight: 700;
    }

    /* CRITERION BARS */
    .crit-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 16px;
    }

    .crit-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .crit-name {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: var(--clr-brown);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .crit-score {
        font-size: 12px;
        font-weight: 700;
        color: var(--clr-dark);
    }

    .kb-bar {
        height: 5px;
        background: #EDE8E0;
        border-radius: 3px;
        overflow: hidden;
    }

    .kb-fill {
        height: 100%;
        border-radius: 3px;
        transition: width .6s ease;
    }

    .fill-taste {
        background: var(--clr-red);
    }

    .fill-pres {
        background: var(--clr-green);
    }

    .fill-crea {
        background: var(--clr-gold);
    }

    .score-comment {
        background: var(--clr-ivory);
        border-left: 3px solid var(--clr-gold);
        border-radius: 0 6px 6px 0;
        padding: 10px 14px;
        font-size: 13px;
        font-style: italic;
        color: var(--clr-dark);
        line-height: 1.5;
    }

    .card-footer-inner {
        padding: 12px 22px;
        border-top: 1px solid #F0EBE2;
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .btn-card-edit {
        background: transparent;
        color: var(--clr-brown);
        border: 1.5px solid #D8D0C6;
        border-radius: var(--radius-btn);
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: var(--transition);
    }

        .btn-card-edit:hover {
            border-color: var(--clr-green);
            color: var(--clr-green);
        }

    .btn-card-del {
        background: transparent;
        color: var(--clr-red);
        border: 1.5px solid rgba(212,72,59,.3);
        border-radius: var(--radius-btn);
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: var(--transition);
    }

        .btn-card-del:hover {
            background: rgba(212,72,59,.08);
            border-color: var(--clr-red);
        }

    /* EMPTY */
    .empty-state {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        text-align: center;
        padding: 80px 24px;
    }

    .empty-wrap {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(74,103,65,.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 28px;
        color: var(--clr-green);
    }

    .empty-state h5 {
        font-family: 'Biryani',sans-serif;
        font-size: 20px;
        color: var(--clr-dark);
    }

    .empty-state p {
        color: var(--clr-brown);
        font-size: 14px;
    }
</style>

<div class="container">
    <div class="page-top">
        <div>
            <h1 class="page-title">Оцінки рецепту</h1>
            <p class="page-sub">Результати суддівського журі</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            @if (User.IsInRole("judge"))
            {
                <a asp-action="Create" asp-route-recipeId="@recipeId" class="btn-primary-kb">
                    <i class="bi bi-plus-lg"></i> Додати оцінку
                </a>
            }
            <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipeId" class="btn-outline-kb">
                <i class="bi bi-arrow-left"></i> До рецепту
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="summary-bar">
            <div class="sum-stat">
                <div class="sum-val">@Model.Count</div>
                <div class="sum-lbl">Суддів оцінили</div>
            </div>
            <div class="sum-div"></div>
            <div class="sum-stat">
                <div class="sum-val">@Model.Sum(s => s.TotalScore)</div>
                <div class="sum-lbl">Загальних балів</div>
            </div>
            <div class="sum-div"></div>
            <div class="sum-stat">
                <div class="sum-val">@Model.Average(s => s.TotalScore).ToString("0.0")</div>
                <div class="sum-lbl">Середній бал</div>
            </div>
            <div class="sum-div"></div>
            <div class="sum-stat">
                <div class="sum-val">@Model.Max(s => s.TotalScore)</div>
                <div class="sum-lbl">Найвища оцінка</div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            @foreach (var score in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="score-card">
                        <div class="card-accent"></div>
                        <div class="card-body-inner">
                            <div class="judge-row">
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div class="judge-avatar"><i class="bi bi-person-fill"></i></div>
                                    <div>
                                        <div class="judge-name">@score.JudgeName</div>
                                        <div class="judge-role">Суддя</div>
                                    </div>
                                </div>
                                <div class="total-badge">@score.TotalScore / 30</div>
                            </div>

                            <div class="crit-list">
                                <div>
                                    <div class="crit-top">
                                        <span class="crit-name"><i class="bi bi-fire"></i> Смак</span>
                                        <span class="crit-score">@score.Taste / 10</span>
                                    </div>
                                    <div class="kb-bar">
                                        <div class="kb-fill fill-taste" style="width:@(score.Taste * 10)%"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="crit-top">
                                        <span class="crit-name"><i class="bi bi-palette"></i> Презентація</span>
                                        <span class="crit-score">@score.Presentation / 10</span>
                                    </div>
                                    <div class="kb-bar">
                                        <div class="kb-fill fill-pres" style="width:@(score.Presentation * 10)%"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="crit-top">
                                        <span class="crit-name"><i class="bi bi-lightbulb"></i> Креативність</span>
                                        <span class="crit-score">@score.Creativity / 10</span>
                                    </div>
                                    <div class="kb-bar">
                                        <div class="kb-fill fill-crea" style="width:@(score.Creativity * 10)%"></div>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(score.Comments))
                            {
                                <div class="score-comment">@score.Comments</div>
                            }
                        </div>

                        @if (User.IsInRole("judge"))
                        {
                            <div class="card-footer-inner">
                                <a asp-controller="Scores" asp-action="Edit" asp-route-id="@score.Id"
                                   class="btn-card-edit">
                                    <i class="bi bi-pencil"></i> Редагувати
                                </a>
                                <form asp-controller="Scores" asp-action="Delete" method="post"
                                      style="margin:0;" onsubmit="return confirm('Видалити оцінку?');">
                                    <input type="hidden" name="id" value="@score.Id" />
                                    <input type="hidden" name="recipeId" value="@recipeId" />
                                    <button type="submit" class="btn-card-del">
                                        <i class="bi bi-trash"></i> Видалити
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-wrap"><i class="bi bi-star"></i></div>
            <h5>Оцінок ще немає</h5>
            <p>Суддівське журі ще не виставило жодної оцінки.</p>
            @if (User.IsInRole("judge"))
            {
                <a asp-action="Create" asp-route-recipeId="@recipeId"
                   class="btn-primary-kb" style="margin-top:16px;display:inline-flex;">
                    <i class="bi bi-plus-lg"></i> Бути першим суддею
                </a>
            }
        </div>
    }
</div>