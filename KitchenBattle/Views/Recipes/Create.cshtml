@model KitchenBattle.ViewModels.RecipeCreateViewModel
@{
    ViewData["Title"] = "Новий рецепт";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --clr-green: #4A6741;
        --clr-green-hover: #6B8F5E;
        --clr-gold: #C47B2B;
        --clr-gold-light: #E8D5A3;
        --clr-ivory: #F5F1E8;
        --clr-white: #FFFFFF;
        --clr-dark: #2C2C2A;
        --clr-brown: #8B7355;
        --clr-red: #D4483B;
        --radius-card: 16px;
        --radius-btn: 6px;
        --radius-pill: 20px;
        --shadow-card: 0 4px 20px rgba(0,0,0,0.08);
        --transition: 0.3s ease;
    }

    body {
        background: var(--clr-ivory) !important;
    }

    .form-page {
        padding: 48px 0 64px;
    }

    .form-card {
        background: var(--clr-white);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        animation: revealCard .5s ease both;
    }

    @@keyframes revealCard {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fieldIn {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* HEADER */
    .form-head {
        background: var(--clr-green);
        padding: 26px 32px;
        position: relative;
        overflow: hidden;
    }

        .form-head::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(45deg,transparent,transparent 12px,rgba(255,255,255,.03) 12px,rgba(255,255,255,.03) 24px);
        }

        .form-head h4 {
            font-family: 'Biryani',sans-serif;
            font-size: 22px;
            font-weight: 800;
            color: var(--clr-white);
            margin: 0;
            position: relative;
            z-index: 1;
        }

        .form-head p {
            color: var(--clr-gold-light);
            font-size: 13px;
            margin: 4px 0 0;
            position: relative;
            z-index: 1;
        }

    /* BODY */
    .form-body {
        padding: 32px;
    }

    /* FIELD */
    .kb-field {
        margin-bottom: 22px;
        animation: fieldIn .4s ease both;
    }

        .kb-field:nth-child(1) {
            animation-delay: .05s
        }

        .kb-field:nth-child(2) {
            animation-delay: .10s
        }

        .kb-field:nth-child(3) {
            animation-delay: .15s
        }

        .kb-field:nth-child(4) {
            animation-delay: .20s
        }

        .kb-field:nth-child(5) {
            animation-delay: .25s
        }

    .kb-label {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 700;
        color: var(--clr-dark);
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: 8px;
    }

    .label-icon {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: rgba(74,103,65,.1);
        color: var(--clr-green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
    }

    .kb-input, .kb-select, .kb-textarea {
        width: 100%;
        border: 1.5px solid #E2DDD4;
        border-radius: var(--radius-btn);
        padding: 12px 16px;
        font-size: 15px;
        color: var(--clr-dark);
        background: var(--clr-white);
        outline: none;
        transition: var(--transition);
        font-family: inherit;
        -webkit-appearance: none;
    }

        .kb-input:focus, .kb-select:focus, .kb-textarea:focus {
            border-color: var(--clr-green);
            box-shadow: 0 0 0 3px rgba(74,103,65,.12);
        }

        .kb-input::placeholder, .kb-textarea::placeholder {
            color: #B8B0A4;
        }

    .kb-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .field-err {
        font-size: 12px;
        color: var(--clr-red);
        margin-top: 5px;
        display: block;
    }

    .form-divider {
        height: 1px;
        background: linear-gradient(to right,transparent,#E2DDD4,transparent);
        margin: 28px 0;
    }

    .info-note {
        background: var(--clr-ivory);
        border-left: 3px solid var(--clr-gold);
        border-radius: 0 8px 8px 0;
        padding: 11px 16px;
        font-size: 13px;
        color: var(--clr-brown);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
    }

    .val-errors {
        background: rgba(212,72,59,.07);
        border: 1px solid rgba(212,72,59,.25);
        border-radius: var(--radius-btn);
        color: var(--clr-red);
        padding: 12px 16px;
        font-size: 13px;
        margin-bottom: 24px;
    }

    /* BUTTONS */
    .btn-submit {
        flex: 1;
        background: var(--clr-gold);
        color: var(--clr-white);
        border: none;
        border-radius: var(--radius-btn);
        padding: 13px 32px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        cursor: pointer;
        transition: var(--transition);
    }

        .btn-submit:hover {
            background: #b36520;
            color: var(--clr-white);
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(196,123,43,.35);
        }

    .btn-cancel {
        background: transparent;
        color: var(--clr-brown);
        border: 1.5px solid #C8C0B4;
        border-radius: var(--radius-btn);
        padding: 13px 24px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: var(--transition);
        white-space: nowrap;
    }

        .btn-cancel:hover {
            border-color: var(--clr-green);
            color: var(--clr-green);
        }
</style>

<div class="form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="form-card">
                    <div class="form-head">
                        <h4><i class="bi bi-plus-circle-fill me-2" style="color:var(--clr-gold-light);"></i>Новий рецепт</h4>
                        <p>Поділіться своєю кулінарною майстерністю</p>
                    </div>

                    <div class="form-body">
                        <form asp-action="Create" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="val-errors"></div>

                            <div class="kb-field">
                                <label asp-for="Title" class="kb-label">
                                    <span class="label-icon"><i class="bi bi-type"></i></span>
                                    Назва страви
                                </label>
                                <input asp-for="Title" class="kb-input" placeholder="Введіть назву страви…">
                                <span asp-validation-for="Title" class="field-err"></span>
                            </div>

                            <div class="kb-field">
                                <label asp-for="Description" class="kb-label">
                                    <span class="label-icon"><i class="bi bi-file-text"></i></span>
                                    Опис
                                </label>
                                <textarea asp-for="Description" class="kb-textarea" rows="4"
                                          placeholder="Опишіть страву, її особливості та секрети…"></textarea>
                                <span asp-validation-for="Description" class="field-err"></span>
                            </div>

                            <div class="kb-field">
                                <label asp-for="Ingredients" class="kb-label">
                                    <span class="label-icon"><i class="bi bi-basket"></i></span>
                                    Інгредієнти
                                </label>
                                <textarea asp-for="Ingredients" class="kb-textarea" rows="4"
                                          placeholder="Перелічіть всі необхідні інгредієнти…"></textarea>
                                <span asp-validation-for="Ingredients" class="field-err"></span>
                            </div>

                            <div class="form-divider"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="CookingTime" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-clock"></i></span>
                                            Час (хвилин)
                                        </label>
                                        <input asp-for="CookingTime" type="number" class="kb-input" placeholder="30">
                                        <span asp-validation-for="CookingTime" class="field-err"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="Difficulty" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-bar-chart"></i></span>
                                            Складність
                                        </label>
                                        <select asp-for="Difficulty" class="kb-select">
                                            <option value="Easy">⭐ Легкий</option>
                                            <option value="Medium">⭐⭐ Середній</option>
                                            <option value="Hard">⭐⭐⭐ Складний</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="Category" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-tag"></i></span>
                                            Категорія
                                        </label>
                                        <select asp-for="Category" class="kb-select">
                                            @foreach (var cat in Enum.GetValues<CategoryEnum>())
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="Picture" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-image"></i></span>
                                            Фото страви
                                        </label>
                                        <input asp-for="Picture" type="file" class="kb-input"
                                               accept="image/*" style="padding:9px 16px;font-size:13px;">
                                        <span asp-validation-for="Picture" class="field-err"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="info-note">
                                <i class="bi bi-info-circle"></i>
                                Рецепт буде збережено як чернетку. Перед публікацією його перевірить адміністратор.
                            </div>

                            <div class="d-flex gap-3">
                                <button type="submit" class="btn-submit">
                                    <i class="bi bi-check-lg me-1"></i>Створити рецепт
                                </button>
                                <a asp-action="Index" class="btn-cancel">
                                    <i class="bi bi-x"></i>Скасувати
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}