@model KitchenBattle.ViewModels.RecipeEditViewModel
@{
    ViewData["Title"] = "Редагування рецепта";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Biryani:wght@400;600;700;800&display=swap" rel="stylesheet">

<div class="form-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="form-card">
                    <div class="form-head">
                        <h4><i class="bi bi-pencil-square me-2" style="color:var(--clr-gold-light);"></i>Редагування рецепта</h4>
                        <p>@Model.Title</p>
                        <span class="status-chip">Статус: @Model.Status</span>
                    </div>

                    <div class="form-body">
                        <form asp-action="Edit" method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ExistingImageUrl" />
                            <input type="hidden" asp-for="Status" />

                            <div asp-validation-summary="ModelOnly" class="val-errors"></div>

                            <div class="edit-notice">
                                <i class="bi bi-info-circle"></i>
                                Редагування доступне лише для чернеток та відхилених рецептів.
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                            {
                                <div class="photo-preview">
                                    <img src="@Model.ExistingImageUrl" alt="Поточне фото">
                                    <div class="photo-lbl">Поточне фото</div>
                                </div>
                            }

                            <div class="kb-field">
                                <label asp-for="Title" class="kb-label">
                                    <span class="label-icon"><i class="bi bi-type"></i></span> Назва страви
                                </label>
                                <input asp-for="Title" class="kb-input">
                                <span asp-validation-for="Title" class="field-err"></span>
                            </div>

                            <div class="kb-field">
                                <label asp-for="Description" class="kb-label">
                                    <span class="label-icon"><i class="bi bi-file-text"></i></span> Опис
                                </label>
                                <textarea asp-for="Description" class="kb-textarea" rows="4"></textarea>
                                <span asp-validation-for="Description" class="field-err"></span>
                            </div>

                            <div class="kb-field">
                                <label asp-for="Ingredients" class="kb-label">
                                    <span class="label-icon"><i class="bi bi-basket"></i></span> Інгредієнти
                                </label>
                                <textarea asp-for="Ingredients" class="kb-textarea" rows="4"></textarea>
                                <span asp-validation-for="Ingredients" class="field-err"></span>
                            </div>

                            <div class="form-divider"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="CookingTime" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-clock"></i></span> Час (хв)
                                        </label>
                                        <input asp-for="CookingTime" type="number" class="kb-input">
                                        <span asp-validation-for="CookingTime" class="field-err"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="Difficulty"
                                               class="kb-label">
                                            <span class="label-icon"><i class="bi bi-bar-chart"></i></span> Складність
                                        </label>
                                        <select asp-for="Difficulty" class="kb-select">
                                            <option value="Easy">⭐ Легкий</option>
                                            <option value="Medium">⭐⭐ Середній</option>
                                            <option value="Hard">⭐⭐⭐ Складний</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="Category" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-tag"></i></span> Категорія
                                        </label>
                                        <select asp-for="Category" class="kb-select">
                                            @foreach (var cat in Enum.GetValues<CategoryEnum>())
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="kb-field">
                                        <label asp-for="Picture" class="kb-label">
                                            <span class="label-icon"><i class="bi bi-image"></i></span> Нове фото
                                        </label>
                                        <input asp-for="Picture" type="file" class="kb-input"
                                               accept="image/*" style="padding:9px 16px;font-size:13px;">
                                        <small style="color:var(--clr-brown);font-size:11px;margin-top:4px;display:block;">
                                            Залиште порожнім, щоб не змінювати фото
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-2">
                                <button type="submit" class="btn-submit">
                                    <i class="bi bi-check-lg me-1"></i>Зберегти зміни
                                </button>
                                <a asp-action="MyRecipes" class="btn-cancel">
                                    <i class="bi bi-x"></i>Скасувати
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}