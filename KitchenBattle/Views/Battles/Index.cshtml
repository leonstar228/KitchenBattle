@model List<KitchenBattle.Models.Battle>
@{
    ViewData["Title"] = "Батли";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var statusFilter = Context.Request.Query["status"].ToString();
    var categoryFilter = Context.Request.Query["category"].ToString();
    var sortBy = Context.Request.Query["sortBy"].ToString();
    var search = Context.Request.Query["search"].ToString();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-trophy-fill text-warning"></i> Кулінарні батли</h2>
        @if (User.IsInRole("admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Створити батл
            </a>
        }
    </div>

    <!-- Фільтри та пошук -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Пошук</label>
                    <input type="text" name="search" class="form-control" placeholder="Назва або опис..." value="@search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Статус</label>
                    <select name="status" class="form-select">
                        <option value="">Всі</option>
                        <option value="Pending" selected="@(statusFilter == "Pending")">Очікується</option>
                        <option value="InProgress" selected="@(statusFilter == "InProgress")">В процесі</option>
                        <option value="Completed" selected="@(statusFilter == "Completed")">Завершені</option>
                        <option value="Closed" selected="@(statusFilter == "Closed")">Закриті</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Категорія</label>
                    <select name="category" class="form-select">
                        <option value="">Всі</option>
                        <option value="Appetizer" selected="@(categoryFilter == "Appetizer")">Закуски</option>
                        <option value="MainCourse" selected="@(categoryFilter == "MainCourse")">Основні страви</option>
                        <option value="Dessert" selected="@(categoryFilter == "Dessert")">Десерти</option>
                        <option value="Soup" selected="@(categoryFilter == "Soup")">Супи</option>
                        <option value="Salad" selected="@(categoryFilter == "Salad")">Салати</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Сортувати</label>
                    <select name="sortBy" class="form-select">
                        <option value="date" selected="@(sortBy == "date")">За датою (нові)</option>
                        <option value="date_old" selected="@(sortBy == "date_old")">За датою (старі)</option>
                        <option value="name" selected="@(sortBy == "name")">За назвою</option>
                        <option value="status" selected="@(sortBy == "status")">За статусом</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Застосувати
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Скинути</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            <i class="bi bi-info-circle fs-4"></i>
            <p class="mb-0">Поки що немає батлів. Заходь пізніше!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var battle in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3">
                            @if (battle.Status == StatusBattleEnum.InProgress)
                            {
                                <span class="badge bg-success">@battle.Status</span>
                            }
                            else if (battle.Status == StatusBattleEnum.Completed)
                            {
                                <span class="badge bg-secondary">@battle.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@battle.Status</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@battle.BattleName</h5>
                            <p class="card-text text-muted small">@battle.Description</p>
                            <div class="mt-2">
                                <span class="badge bg-light text-dark border">@battle.Category</span>
                            </div>
                            <div class="mt-3 text-muted small">
                                <i class="bi bi-calendar-event"></i> Старт: @battle.StartedAt.ToString("dd.MM.yyyy")
                                @if (battle.EndedAt.HasValue)
                                {
                                    <br /><i class="bi bi-calendar-check"></i> Фініш:
                                    @battle.EndedAt.Value.ToString("dd.MM.yyyy");
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a asp-action="Details" asp-route-id="@battle.Id" class="btn btn-outline-primary w-100">
                                <i class="bi bi-eye"></i> Деталі
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-status="@statusFilter" asp-route-category="@categoryFilter" asp-route-sortBy="@sortBy">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" asp-route-page="@i" asp-route-search="@search" asp-route-status="@statusFilter" asp-route-category="@categoryFilter" asp-route-sortBy="@sortBy">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-status="@statusFilter" asp-route-category="@categoryFilter" asp-route-sortBy="@sortBy">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>