﻿
@model List<KitchenBattle.Models.Battle>
@{
    ViewData["Title"] = "Кулінарні батли";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var statusFilter = Context.Request.Query["status"].ToString();
    var categoryFilter = Context.Request.Query["category"].ToString();
    var sortBy = Context.Request.Query["sortBy"].ToString();
    var search = Context.Request.Query["search"].ToString();
}

<div class="container mt-4">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 style="color: var(--primary); font-weight: 700; font-size: 32px; margin: 0;">
            Кулінарні батли
        </h1>
        <p style="color: var(--neutral-600); margin-top: 8px; font-size: 16px;">
            Оберіть батл та покажіть свою майстерність!
        </p>
        @if (User.IsInRole("admin"))
        {
            <a asp-action="Create" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 8px 24px; margin-top: 10px; display: inline-block;">
                <i class="bi bi-plus-lg"></i> Створити батл
            </a>
        }
    </div>

    <!-- Фільтри -->
    <div style="background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 20px; margin-bottom: 30px;">
        <form method="get">
            <div style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
                <div style="flex: 2; min-width: 180px;">
                    <label style="color: var(--neutral-600); font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Пошук</label>
                    <input type="text" name="search" class="form-control" style="border-radius: 25px; border: 1px solid var(--gold-200); padding: 10px 16px; width: 100%; height: 42px;" placeholder="Пошук батлу..." value="@search" />
                </div>
                <div style="flex: 1; min-width: 140px;">
                    <label style="color: var(--neutral-600); font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Статус</label>
                    <select name="status" class="form-select" style="border-radius: 25px; border: 1px solid var(--gold-200); padding: 10px 16px; width: 100%; height: 42px;">
                        <option value="">Всі статуси</option>
                        <option value="Pending" selected="@(statusFilter == "Pending")">Очікується</option>
                        <option value="InProgress" selected="@(statusFilter == "InProgress")">В процесі</option>
                        <option value="Completed" selected="@(statusFilter == "Completed")">Завершені</option>
                    </select>
                </div>
                <div style="flex: 1; min-width: 140px;">
                    <label style="color: var(--neutral-600); font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Категорія</label>
                    <select name="category" class="form-select" style="border-radius: 25px; border: 1px solid var(--gold-200); padding: 10px 16px; width: 100%; height: 42px;">
                        <option value="">Всі категорії</option>
                        <option value="Appetizer" selected="@(categoryFilter == "Appetizer")">Закуски</option>
                        <option value="MainCourse" selected="@(categoryFilter == "MainCourse")">Основні страви</option>
                        <option value="Dessert" selected="@(categoryFilter == "Dessert")">Десерти</option>
                        <option value="Soup" selected="@(categoryFilter == "Soup")">Супи</option>
                    </select>
                </div>
                <div style="flex: 1; min-width: 140px;">
                    <label style="color: var(--neutral-600); font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Сортувати</label>
                    <select name="sortBy" class="form-select" style="border-radius: 25px; border: 1px solid var(--gold-200); padding: 10px 16px; width: 100%; height: 42px;">
                        <option value="date" selected="@(sortBy == "date")">Нові спочатку</option>
                        <option value="date_old" selected="@(sortBy == "date_old")">Старі спочатку</option>
                        <option value="name" selected="@(sortBy == "name")">За назвою</option>
                    </select>
                </div>
                <div style="flex: 1.2; min-width: 180px;">
                    <label style="opacity: 0; margin-bottom: 6px; display: block; height: 13px;">.</label>
                    <div style="display: flex; gap: 10px;">
                        <button type="submit" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 0 20px; height: 42px; flex: 1; font-weight: 500; border: none; font-size: 14px;">
                            <i class="bi bi-search"></i> Застосувати
                        </button>
                        <a asp-action="Index" class="btn" style="border: 1px solid var(--gold-200); color: var(--neutral-600); border-radius: 25px; padding: 0 20px; height: 42px; flex: 1; text-align: center; background-color: var(--white); text-decoration: none; display: flex; align-items: center; justify-content: center; font-size: 14px;">
                            Скинути
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown" style="font-size: 64px; color: var(--gold-200);"></i>
            <h3 style="color: var(--primary); margin-top: 20px;">Поки що немає батлів</h3>
            <p style="color: var(--neutral-600);">Заходьте пізніше!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var battle in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100" style="background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: transform 0.2s; overflow: hidden;">
                        <div style="background-color: var(--primary); height: 100px; display: flex; align-items: center; justify-content: center; position: relative;">
                            <i class="bi bi-trophy" style="font-size: 48px; color: var(--gold-200);"></i>
                            @if (battle.Status == StatusBattleEnum.InProgress)
                            {
                                <span style="position: absolute; top: 10px; right: 10px; background-color: var(--green-400); color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;">ТРИВАЄ</span>
                            }
                            else if (battle.Status == StatusBattleEnum.Completed)
                            {
                                <span style="position: absolute; top: 10px; right: 10px; background-color: var(--neutral-600); color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;">ЗАВЕРШЕНО</span>
                            }
                            else
                            {
                                <span style="position: absolute; top: 10px; right: 10px; background-color: var(--gold-200); color: var(--dark); padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;">СКОРО</span>
                            }
                        </div>
                        <div class="card-body" style="padding: 16px;">
                            <div style="margin-bottom: 8px;">
                                <span style="color: var(--neutral-600); font-size: 12px;">
                                    <i class="bi bi-tag"></i> @battle.Category
                                </span>
                            </div>
                            <h5 style="color: var(--primary); font-weight: 700; margin-bottom: 8px; font-size: 18px;">@battle.BattleName</h5>
                            <p style="color: var(--neutral-600); font-size: 13px; line-height: 1.4; margin-bottom: 12px;">
                                @(battle.Description.Length > 80 ? battle.Description.Substring(0, 80) + "..." : battle.Description)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div>
                                    <span style="color: var(--secondary); font-size: 13px;">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-half"></i>
                                    </span>
                                    <span style="color: var(--neutral-600); font-size: 13px; margin-left: 5px;">4.5</span>
                                </div>
                                <div style="background-color: var(--primary); color: white; border-radius: 20px; padding: 4px 12px; font-size: 12px;">
                                    <i class="bi bi-people"></i> @battle.BattleChefs.Count(c => c.IsApproved)
                                </div>
                            </div>
                        </div>
                        <div class="card-footer" style="background-color: transparent; border-top: 1px solid var(--gold-200); padding: 12px 16px;">
                            <a asp-action="Details" asp-route-id="@battle.Id" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 8px 12px; text-align: center; display: block; width: 100%;">
                                <i class="bi bi-eye"></i> Деталі
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" style="border-radius: 25px; color: var(--secondary);" 
                           asp-route-page="@(currentPage - 1)">‹</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" style="border-radius: 25px; background: @(currentPage == i ? "var(--secondary)" : "transparent"); color: @(currentPage == i ? "white" : "var(--secondary)"); border-color: var(--gold-200);" 
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" style="border-radius: 25px; color: var(--secondary);" 
                           asp-route-page="@(currentPage + 1)">›</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>