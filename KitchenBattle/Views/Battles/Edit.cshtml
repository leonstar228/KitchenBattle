@model KitchenBattle.ViewModels.BattleCreateViewModel
@{
    ViewData["Title"] = "Редагувати батл";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card" style="background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow: hidden;">
                <div style="background-color: var(--secondary); padding: 15px 25px;">
                    <h3 style="color: var(--white); font-weight: 700; margin: 0;">
                        <i class="bi bi-pencil-square"></i> Редагування батлу
                    </h3>
                </div>
                <div style="padding: 30px;">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="BattleName" class="form-label fw-semibold" style="color: var(--primary);">Назва батлу</label>
                            <input asp-for="BattleName" class="form-control" style="border-radius: 25px; border-color: var(--gold-200); padding: 10px 15px;" />
                            <span asp-validation-for="BattleName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold" style="color: var(--primary);">Опис</label>
                            <textarea asp-for="Description" class="form-control" rows="3" style="border-radius: 16px; border-color: var(--gold-200); padding: 10px 15px;"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-semibold" style="color: var(--primary);">Категорія</label>
                            <select asp-for="Category" class="form-select" style="border-radius: 25px; border-color: var(--gold-200); padding: 10px 15px;" asp-items="Html.GetEnumSelectList<CategoryEnum>()"></select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RegistrationStart" class="form-label" style="color: var(--primary);">Початок реєстрації</label>
                                <input asp-for="RegistrationStart" class="form-control" type="datetime-local" style="border-radius: 25px; border-color: var(--gold-200); padding: 10px 15px;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RegistrationEnd" class="form-label" style="color: var(--primary);">Кінець реєстрації</label>
                                <input asp-for="RegistrationEnd" class="form-control" type="datetime-local" style="border-radius: 25px; border-color: var(--gold-200); padding: 10px 15px;" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartedAt" class="form-label" style="color: var(--primary);">Початок батлу</label>
                                <input asp-for="StartedAt" class="form-control" type="datetime-local" style="border-radius: 25px; border-color: var(--gold-200); padding: 10px 15px;" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndedAt" class="form-label" style="color: var(--primary);">Завершення</label>
                                <input asp-for="EndedAt" class="form-control" type="datetime-local" style="border-radius: 25px; border-color: var(--gold-200); padding: 10px 15px;" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Details" asp-route-id="@ViewBag.BattleId" class="btn" style="border: 1px solid var(--neutral-600); color: var(--neutral-600); border-radius: 25px; padding: 10px 30px;">Скасувати</a>
                            <button type="submit" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 10px 30px;">
                                <i class="bi bi-save"></i> Зберегти
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>