@model KitchenBattle.ViewModels.BattleCreateViewModel
@{
    ViewData["Title"] = "Редагувати батл";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Редагування батлу</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="BattleName" class="form-label fw-semibold">Назва батлу</label>
                            <input asp-for="BattleName" class="form-control" />
                            <span asp-validation-for="BattleName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Опис</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-semibold">Категорія</label>
                            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<CategoryEnum>()"></select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RegistrationStart" class="form-label">Початок реєстрації</label>
                                <input asp-for="RegistrationStart" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RegistrationEnd" class="form-label">Кінець реєстрації</label>
                                <input asp-for="RegistrationEnd" class="form-control" type="datetime-local" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartedAt" class="form-label">Початок батлу</label>
                                <input asp-for="StartedAt" class="form-control" type="datetime-local" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndedAt" class="form-label">Завершення</label>
                                <input asp-for="EndedAt" class="form-control" type="datetime-local" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@ViewBag.BattleId" class="btn btn-secondary">Скасувати</a>
                            <button type="submit" class="btn btn-primary">Зберегти</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>