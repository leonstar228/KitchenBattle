@model KitchenBattle.Models.Battle
@using System.Security.Claims
@using KitchenBattle.Models
@{
    ViewData["Title"] = Model.BattleName;
    var pendingChefs = ViewBag.PendingChefs as List<KitchenBattle.Models.Chef> ?? new List<KitchenBattle.Models.Chef>();
    var approvedChefs = ViewBag.ApprovedChefs as List<KitchenBattle.Models.Chef> ?? new List<KitchenBattle.Models.Chef>();
    var chefRecipes = ViewBag.ChefRecipes as List<KitchenBattle.Models.Recipe> ?? new List<KitchenBattle.Models.Recipe>();
    var chefId = User.FindFirstValue("sub") ?? User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
    var hasRecipeInBattle = Model.Recipes.Any(r => r.ChefId == chefId);
}

<div class="container mt-4">

    <!-- ДОДАНО: Блок відображення спливаючих сповіщень помилок та успіху з TempData -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius: 15px; box-shadow: 0 4px 12px rgba(212,72,59,0.15);">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius: 15px; box-shadow: 0 4px 12px rgba(74,103,65,0.15);">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-3"></div>
        <div class="col-6 text-center">
            <h1 style="color: var(--primary); font-weight: 700; margin: 0; font-size: 24px;">
                Деталі кулінарного батлу
            </h1>
            <p style="color: var(--neutral-600); margin: 5px 0 0 0;">@Model.BattleName</p>
        </div>
        <div class="col-3 text-end">
            @if (User.IsInRole("admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn" style="border: 1px solid var(--gold-200); color: var(--secondary); border-radius: 25px; padding: 6px 16px; margin-right: 8px;">
                    <i class="bi bi-pencil"></i>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn" style="border: 1px solid var(--gold-200); color: var(--accent-red); border-radius: 25px; padding: 6px 16px; margin-right: 8px;">
                    <i class="bi bi-trash"></i>
                </a>
            }
            <a asp-action="Index" class="btn" style="border: 1px solid var(--gold-200); color: var(--neutral-600); border-radius: 25px; padding: 6px 16px;">
                <i class="bi bi-arrow-left"></i> Назад
            </a>
        </div>
    </div>

    <!-- Status Banner -->
    <div style="background-color: var(--gold-200); border-radius: 25px; padding: 12px 20px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            @if (Model.Status == StatusBattleEnum.InProgress)
            {
                <span style="color: var(--green-400); font-weight: 600;">
                    <i class="bi bi-play-circle-fill"></i> БАТЛ ТРИВАЄ
                </span>
            }
            @if (Model.Status == StatusBattleEnum.Completed)
            {
                <span style="color: var(--neutral-600); font-weight: 600;">
                    <i class="bi bi-check-circle-fill"></i> БАТЛ ЗАВЕРШЕНО
                </span>
            }
            @if (Model.Status == StatusBattleEnum.Pending)
            {
                <span style="color: var(--secondary); font-weight: 600;">
                    <i class="bi bi-clock-fill"></i> ОЧІКУЄТЬСЯ
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.WinnerId))
            {
                <span style="color: var(--secondary); font-size: 14px;">
                    <i class="bi bi-crown-fill"></i> Переможець: @(Model.WinnerId.Length > 12 ? Model.WinnerId.Substring(0, 12) + "..." : Model.WinnerId)
                </span>
            }
        </div>
    </div>

    <!-- Дві колонки: Інформація + Рецепти -->
    <div style="display: flex; gap: 24px; margin-bottom: 24px; flex-wrap: wrap;">
        <!-- Ліва колонка - Інформація -->
        <div style="flex: 0 0 35%; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background);">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-info-circle"></i> Інформація
                </h5>
            </div>
            <div style="padding: 16px;">
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Категорія</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.Category</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Початок реєстрації</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.RegistrationStart.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Кінець реєстрації</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.RegistrationEnd.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Старт батлу</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.StartedAt.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                @if (Model.EndedAt.HasValue)
                {
                    <div style="margin-bottom: 14px;">
                        <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Завершення</div>
                        <div style="color: var(--dark); font-weight: 500;">@Model.EndedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>

        <!-- Права колонка - Рецепти -->
        <div style="flex: 1; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background); display: flex; justify-content: space-between; align-items: center;">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-book"></i> Рецепти (@Model.Recipes.Count)
                </h5>
                @if (User.IsInRole("chef") && Model.Status == StatusBattleEnum.InProgress && approvedChefs.Any(c => c.Id == chefId) && !hasRecipeInBattle)
                {
                    <button type="button" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 4px 12px; font-size: 13px;" data-bs-toggle="modal" data-bs-target="#addRecipeModal">
                        <i class="bi bi-plus"></i> Додати рецепт
                    </button>
                }
            </div>
            <div style="padding: 16px;">
                @if (!Model.Recipes.Any())
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <i class="bi bi-emoji-frown" style="font-size: 40px; color: var(--gold-200);"></i>
                        <p style="color: var(--neutral-600); margin-top: 10px;">Поки немає рецептів</p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var recipe in Model.Recipes)
                        {
                            <div style="background-color: var(--background); border-radius: 12px; padding: 12px; display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div style="font-weight: 600; color: var(--dark);">@recipe.Title</div>
                                    <div style="font-size: 12px; color: var(--neutral-600);">@recipe.ChefName</div>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <span style="color: var(--secondary); font-size: 14px;">
                                        <i class="bi bi-star-fill"></i> @recipe.AverageScore.ToString("F1")
                                    </span>
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="btn" style="border: 1px solid var(--gold-200); border-radius: 25px; padding: 4px 10px; font-size: 12px;">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("judge") && Model.Status == StatusBattleEnum.InProgress)
                                    {
                                        <a asp-controller="Scores" asp-action="Create" asp-route-recipeId="@recipe.Id" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 4px 10px; font-size: 12px;">
                                            <i class="bi bi-star"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Картка Шефів (МОДИФІКОВАНО: додано перевірку часових рамок реєстрації) -->
    <div class="row mb-4">
        <div class="col-12">
            <div style="background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                        <i class="bi bi-people"></i> Шефи (@approvedChefs.Count)
                    </h5>

                    @if (User.IsInRole("chef"))
                    {
                        var now = DateTime.UtcNow;

                        if (now < Model.RegistrationStart)
                        {
                            <span class="badge bg-warning text-dark p-2" style="border-radius: 12px; font-size: 13px;">
                                <i class="bi bi-calendar-event"></i> Реєстрація з @Model.RegistrationStart.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        }
                        else if (now > Model.RegistrationEnd)
                        {
                            <span class="badge bg-danger p-2" style="border-radius: 12px; font-size: 13px;">
                                <i class="bi bi-calendar-x"></i> Реєстрацію закрито
                            </span>
                        }
                        else if (Model.Status != StatusBattleEnum.Pending)
                        {
                            <span class="badge bg-secondary p-2" style="border-radius: 12px; font-size: 13px;">
                                Батл розпочато
                            </span>
                        }
                        else if (approvedChefs.Any(c => c.Id == chefId) || pendingChefs.Any(c => c.Id == chefId))
                        {
                            <span class="badge bg-success p-2" style="border-radius: 12px; font-size: 13px;">
                                <i class="bi bi-check-lg"></i> Ви вже подали заявку
                            </span>
                        }
                        else
                        {
                            <form asp-action="RegisterChef" asp-route-id="@Model.Id" method="post" style="margin: 0;">
                                <button type="submit" class="btn text-white" style="background-color: var(--secondary); border-radius: 20px; padding: 6px 16px; font-size: 13px;">
                                    <i class="bi bi-person-plus"></i> Зареєструватись
                                </button>
                            </form>
                        }
                    }
                </div>

                <div class="d-flex flex-wrap gap-2">
                    @if (!approvedChefs.Any())
                    {
                        <p class="text-muted" style="font-size: 14px; margin: 0;">Наразі немає зареєстрованих шефів.</p>
                    }
                    else
                    {
                        @foreach (var chef in approvedChefs)
                        {
                            <span class="badge bg-light text-dark border p-2" style="border-radius: 8px; font-size: 14px;">
                                <i class="bi bi-person-fill text-secondary"></i> @chef.FullName
                            </span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Модальне вікно для вибору рецепту -->
<div class="modal fade" id="addRecipeModal" tabindex="-1" aria-labelledby="addRecipeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header" style="background-color: var(--primary); color: var(--white); border: none;">
                <h5 class="modal-title" id="addRecipeModalLabel">
                    <i class="bi bi-plus-circle"></i> Додати рецепт до батлу
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                @if (hasRecipeInBattle)
                {
                    <div class="alert alert-warning text-center" style="border-radius: 12px;">
                        <i class="bi bi-info-circle"></i>
                        <strong>Ви вже додали рецепт до цього батлу!</strong><br>
                        Кожен учасник може додати лише один рецепт.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @if (chefRecipes.Any())
                        {
                            <div>
                                <label class="form-label fw-semibold" style="color: var(--primary);">Мої рецепти</label>
                                <div class="list-group" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var recipe in chefRecipes)
                                    {
                                        <form asp-action="AddExistingRecipe" method="post" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" style="border-radius: 8px; margin-bottom: 4px;">
                                            <input type="hidden" name="battleId" value="@Model.Id" />
                                            <input type="hidden" name="recipeId" value="@recipe.Id" />
                                            <div>
                                                <div class="fw-bold">@recipe.Title</div>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius: 15px;">
                                                Обрати
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <p>У вас немає опублікованих рецептів для цієї категорії.</p>
                                <a asp-controller="Recipes" asp-action="Create" class="btn btn-sm btn-primary" style="border-radius: 20px;">Створити новий рецепт</a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>