@model KitchenBattle.Models.Battle
@{
    ViewData["Title"] = Model.BattleName;
    var pendingChefs = ViewBag.PendingChefs as List<KitchenBattle.Models.Chef> ?? new List<KitchenBattle.Models.Chef>();
    var approvedChefs = ViewBag.ApprovedChefs as List<KitchenBattle.Models.Chef> ?? new List<KitchenBattle.Models.Chef>();
}

<div class="container mt-4">
    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-3"></div>
        <div class="col-6 text-center">
            <h1 style="color: var(--primary); font-weight: 700; margin: 0; font-size: 24px;">
                Деталі кулінарного батлу
            </h1>
            <p style="color: var(--neutral-600); margin: 5px 0 0 0;">@Model.BattleName</p>
        </div>
        <div class="col-3 text-end">
            @if (User.IsInRole("admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn" style="border: 1px solid var(--gold-200); color: var(--secondary); border-radius: 25px; padding: 6px 16px; margin-right: 8px;">
                    <i class="bi bi-pencil"></i>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn" style="border: 1px solid var(--gold-200); color: var(--accent-red); border-radius: 25px; padding: 6px 16px; margin-right: 8px;">
                    <i class="bi bi-trash"></i>
                </a>
            }
            <a asp-action="Index" class="btn" style="border: 1px solid var(--gold-200); color: var(--neutral-600); border-radius: 25px; padding: 6px 16px;">
                <i class="bi bi-arrow-left"></i> Назад
            </a>
        </div>
    </div>

    <!-- Status Banner -->
    <div style="background-color: var(--gold-200); border-radius: 25px; padding: 12px 20px; margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            @if (Model.Status == StatusBattleEnum.InProgress)
            {
                <span style="color: var(--green-400); font-weight: 600;">
                    <i class="bi bi-play-circle-fill"></i> БАТЛ ТРИВАЄ
                </span>
            }
            else if (Model.Status == StatusBattleEnum.Completed)
            {
                <span style="color: var(--neutral-600); font-weight: 600;">
                    <i class="bi bi-check-circle-fill"></i> БАТЛ ЗАВЕРШЕНО
                </span>
            }
            else
            {
                <span style="color: var(--secondary); font-weight: 600;">
                    <i class="bi bi-clock-fill"></i> ОЧІКУЄТЬСЯ
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.WinnerId))
            {
                <span style="color: var(--secondary); font-size: 14px;">
                    <i class="bi bi-crown-fill"></i> Переможець: @(Model.WinnerId.Length > 12 ? Model.WinnerId.Substring(0, 12) + "..." : Model.WinnerId)
                </span>
            }
        </div>
    </div>

    <!-- Дві колонки -->
    <div style="display: flex; gap: 24px; margin-bottom: 24px; flex-wrap: wrap;">
        <!-- Ліва колонка - Інформація -->
        <div style="flex: 0 0 35%; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background);">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-info-circle"></i> Інформація
                </h5>
            </div>
            <div style="padding: 16px;">
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Категорія</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.Category</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Початок реєстрації</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.RegistrationStart.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Кінець реєстрації</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.RegistrationEnd.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                <div style="margin-bottom: 14px;">
                    <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Старт батлу</div>
                    <div style="color: var(--dark); font-weight: 500;">@Model.StartedAt.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
                @if (Model.EndedAt.HasValue)
                {
                    <div style="margin-bottom: 14px;">
                        <div style="color: var(--neutral-600); font-size: 12px; margin-bottom: 4px;">Завершення</div>
                        <div style="color: var(--dark); font-weight: 500;">@Model.EndedAt.Value.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                }
            </div>
        </div>

        <!-- Права колонка - Рецепти -->
        <div style="flex: 1; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background); display: flex; justify-content: space-between; align-items: center;">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-book"></i> Рецепти (@Model.Recipes.Count)
                </h5>
                @if (User.IsInRole("chef") && Model.Status == StatusBattleEnum.InProgress)
                {
                    <a asp-controller="Recipes" asp-action="Create" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 4px 12px; font-size: 13px;">
                        <i class="bi bi-plus"></i> Додати
                    </a>
                }
            </div>
            <div style="padding: 16px;">
                @if (!Model.Recipes.Any())
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <i class="bi bi-emoji-frown" style="font-size: 40px; color: var(--gold-200);"></i>
                        <p style="color: var(--neutral-600); margin-top: 10px;">Поки немає рецептів</p>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var recipe in Model.Recipes)
                        {
                            <div style="background-color: var(--background); border-radius: 12px; padding: 12px; display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div style="font-weight: 600; color: var(--dark);">@recipe.Title</div>
                                    <div style="font-size: 12px; color: var(--neutral-600);">@recipe.ChefName</div>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <span style="color: var(--secondary); font-size: 14px;">
                                        <i class="bi bi-star-fill"></i> @recipe.AverageScore.ToString("F1")
                                    </span>
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="btn" style="border: 1px solid var(--gold-200); border-radius: 25px; padding: 4px 10px; font-size: 12px;">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("judge") && Model.Status == StatusBattleEnum.InProgress)
                                    {
                                        <a asp-controller="Scores" asp-action="Create" asp-route-recipeId="@recipe.Id" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 4px 10px; font-size: 12px;">
                                            <i class="bi bi-star"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Дві колонки для Шефів і Суддів -->
    <div style="display: flex; gap: 24px; flex-wrap: wrap;">
        <!-- Шефи -->
        <div style="flex: 1; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-people"></i> Шефи (@approvedChefs.Count)
                </h5>
                @if (User.IsInRole("chef") && Model.Status == StatusBattleEnum.Pending && DateTime.UtcNow <= Model.RegistrationEnd)
                {
                    <form asp-action="RegisterChef" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn" style="background-color: var(--secondary); color: var(--white); border-radius: 25px; padding: 4px 12px; font-size: 13px;">
                            <i class="bi bi-person-plus"></i> Зареєструватись
                        </button>
                    </form>
                }
            </div>
            <div style="padding: 16px;">
                @if (!approvedChefs.Any())
                {
                    <p style="text-align: center; padding: 20px; color: var(--neutral-600); margin: 0;">Немає підтверджених учасників</p>
                }
                else
                {
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var chef in approvedChefs)
                        {
                            <span style="background-color: var(--primary); color: var(--white); padding: 5px 12px; border-radius: 20px; font-size: 13px;">
                                <i class="bi bi-person-check-fill"></i> @(chef.FullName?.Length > 20 ? chef.FullName.Substring(0, 20) + "..." : chef.FullName ?? (chef.Id.Length > 12 ? chef.Id.Substring(0, 12) + "..." : chef.Id))
                            </span>
                        }
                    </div>
                }

                <!-- Очікують підтвердження - бачать всі -->
                @if (pendingChefs.Any())
                {
                    <hr style="border-color: var(--gold-200); margin: 16px 0;">
                    <h6 style="color: var(--secondary); margin-bottom: 10px;">
                        <i class="bi bi-clock-history"></i> Очікують підтвердження:
                    </h6>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var chef in pendingChefs)
                        {
                            <span style="background-color: var(--gold-200); color: var(--dark); padding: 5px 12px; border-radius: 20px; font-size: 13px;">
                                <i class="bi bi-person"></i> @(chef.FullName?.Length > 20 ? chef.FullName.Substring(0, 20) + "..." : chef.FullName ?? (chef.Id.Length > 12 ? chef.Id.Substring(0, 12) + "..." : chef.Id))
                                <span style="font-size: 11px; margin-left: 5px;">(очікує)</span>
                            </span>
                        }
                    </div>
                }

                <!-- Адмін може підтверджувати -->
                @if (User.IsInRole("admin") && pendingChefs.Any())
                {
                    <hr style="border-color: var(--gold-200); margin: 16px 0;">
                    <h6 style="color: var(--secondary); margin-bottom: 10px;">Дії адміністратора:</h6>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var chef in pendingChefs)
                        {
                            <div style="display: flex; align-items: center; gap: 8px; background-color: var(--gold-200); padding: 5px 12px; border-radius: 20px;">
                                <span style="color: var(--dark); font-size: 13px;">
                                    <i class="bi bi-person"></i> @(chef.FullName?.Length > 20 ? chef.FullName.Substring(0, 20) + "..." : chef.FullName ?? (chef.Id.Length > 12 ? chef.Id.Substring(0, 12) + "..." : chef.Id))
                                </span>
                                <form asp-action="ApproveChef" asp-route-battleId="@Model.Id" asp-route-chefId="@chef.Id" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn" style="background-color: var(--primary); color: white; border-radius: 20px; padding: 2px 8px; font-size: 11px;">✓ Підтвердити</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Судді (тільки перегляд) -->
        <div style="flex: 1; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background);">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-gavel"></i> Судді (@Model.BattleJudges.Count)
                </h5>
            </div>
            <div style="padding: 16px;">
                @if (!Model.BattleJudges.Any())
                {
                    <p style="text-align: center; padding: 20px; color: var(--neutral-600); margin: 0;">Немає суддів</p>
                }
                else
                {
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var bj in Model.BattleJudges)
                        {
                            <span style="background-color: var(--gold-200); color: var(--dark); padding: 5px 12px; border-radius: 20px; font-size: 13px;">
                                <i class="bi bi-person-badge"></i> @(bj.Judge?.FullName?.Length > 20 ? bj.Judge.FullName.Substring(0, 20) + "..." : bj.Judge?.FullName ?? (bj.JudgeId.Length > 12 ? bj.JudgeId.Substring(0, 12) + "..." : bj.JudgeId))
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Admin Controls -->
    @if (User.IsInRole("admin") && Model.Status != StatusBattleEnum.Completed)
    {
        <div style="margin-top: 24px; background-color: var(--white); border-radius: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow: hidden;">
            <div style="padding: 16px; border-bottom: 1px solid var(--gold-200); background-color: var(--background);">
                <h5 style="color: var(--primary); margin: 0; font-weight: 600;">
                    <i class="bi bi-gear"></i> Керування
                </h5>
            </div>
            <div style="padding: 16px;">
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    @if (Model.Status == StatusBattleEnum.Pending)
                    {
                        <form asp-action="StartBattle" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn" style="background-color: var(--primary); color: var(--white); border-radius: 25px; padding: 6px 16px;">
                                <i class="bi bi-play-fill"></i> Почати батл
                            </button>
                        </form>
                        <form asp-action="CloseRegistration" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn" style="border: 1px solid var(--secondary); color: var(--secondary); border-radius: 25px; padding: 6px 16px;">
                                <i class="bi bi-lock-fill"></i> Закрити реєстрацію
                            </button>
                        </form>
                    }
                    @if (Model.Status == StatusBattleEnum.InProgress)
                    {
                        <form asp-action="FinishBattle" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn" style="background-color: var(--accent-red); color: var(--white); border-radius: 25px; padding: 6px 16px;">
                                <i class="bi bi-flag-fill"></i> Завершити батл
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>