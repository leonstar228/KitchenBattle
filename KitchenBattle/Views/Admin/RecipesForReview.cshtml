
@model IEnumerable<KitchenBattle.Models.Recipe>

@{
    ViewData["Title"] = "Перевірка рецептів";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold m-0 d-flex align-items-center" style="color: #2C2C2A; font-size: 2rem;">
                <i class="bi bi-bookmark-check" style="margin-right: 0.75rem; color: var(--kb-primary);"></i>
                Рецепти на модерації
            </h2>
            <p class="text-muted m-0 mt-2 small">Перевірка та публікація нових страв від користувачів</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm kb-btn-back px-4 py-2">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert empty-state text-center p-5 shadow-sm" style="border-radius: 12px;">
            <div style="font-size: 3rem; color: var(--kb-primary); margin-bottom: 1rem;">
                <i class="bi bi-check-circle"></i>
            </div>
            <h5 class="fw-bold m-0" style="color: var(--kb-primary); font-size: 1.25rem;">Усі рецепти успішно перевірено</h5>
            <p class="text-muted m-0 mt-2">Немає рецептів, які очікують на модерацію</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var recipe in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card kb-recipe-card shadow-sm h-100">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <span class="badge px-3 py-2" style="background: linear-gradient(135deg, #E8D5A3 0%, #d4b896 100%); color: #2C2C2A; font-weight: 600;">
                                        <i class="bi bi-tag"></i> @recipe.Category
                                    </span>
                                    <small class="text-muted" style="font-weight: 500;">ID: @recipe.Id</small>
                                </div>

                                <h4 class="card-title fw-bold mb-3" style="color: #2C2C2A; font-size: 1.1rem;">@recipe.Title</h4>

                                <div class="mb-4 pt-3 border-top" style="font-size: 0.9rem; color: var(--kb-neutral-600);">
                                    <div class="mb-2"><i class="bi bi-person-circle" style="margin-right: 0.5rem;"></i><strong>Автор:</strong> @recipe.ChefName</div>
                                    <div><i class="bi bi-hourglass-split" style="margin-right: 0.5rem; color: #D4483B;"></i><strong>Статус:</strong> <span style="color: #D4483B; font-weight: 600;">Очікує перевірки</span></div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" class="btn kb-btn-details py-2">
                                    <i class="bi bi-eye"></i> Переглянути деталі
                                </a>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <form asp-controller="Admin" asp-action="ApproveRecipe" asp-route-id="@recipe.Id" method="post" class="w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn kb-btn-approve w-100 py-2">
                                                <i class="bi bi-check-lg"></i> Схвалити
                                            </button>
                                        </form>
                                    </div>
                                    <div class="col-6">
                                        <form asp-controller="Admin" asp-action="RejectRecipe" asp-route-id="@recipe.Id" method="post" class="w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn kb-btn-reject w-100 py-2">
                                                <i class="bi bi-x-lg"></i> Відхилити
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>