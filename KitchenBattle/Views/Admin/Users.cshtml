@model IEnumerable<KitchenBattle.Models.ApplicationUser>

@{
    ViewData["Title"] = "Користувачі";
}

<style>
    body { background-color: #F5F1E8 !important; color: #2C2C2A; }
    .kb-table-container { background: #ffffff; border-radius: 12px; border: none; overflow: hidden; }
    .kb-btn-delete { background-color: transparent; color: #D4483B; border: 1px solid #D4483B; font-weight: 600; border-radius: 4px; padding: 5px 14px; transition: all 0.2s; }
    .kb-btn-delete:hover { background-color: #D4483B; color: #ffffff; }
    .kb-btn-back { background-color: transparent; border: 1px solid #8B7355; color: #8B7355; font-weight: 600; border-radius: 4px; }
    .kb-btn-back:hover { background-color: #8B7355; color: #ffffff; }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0" style="color: #2C2C2A;">Керування користувачами</h2>
            <p class="text-muted m-0 small">Список зареєстрованих облікових записів у системі</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn kb-btn-back px-4 py-2">Назад до панелі</a>
    </div>

    <div class="table-responsive kb-table-container p-4 shadow-sm">
        <table class="table align-middle m-0 table-hover">
            <thead style="background-color: #FDFBF7; color: #8B7355; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em;">
                <tr>
                    <th class="py-3 border-0 px-3">Ім'я користувача</th>
                    <th class="py-3 border-0">Email адреса</th>
                    <th class="py-3 border-0 text-end px-3">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr style="border-bottom: 1px solid rgba(0,0,0,0.04);">
                        <td class="py-3 px-3 fw-semibold" style="color: #2C2C2A;">@user.UserName</td>
                        <td class="text-end py-3 px-3">
                            <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                  onsubmit="return confirm('Ви впевнені, що хочете видалити цього користувача?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm kb-btn-delete">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>