@model Dictionary<KitchenBattle.Models.CategoryEnum, double>

@{
    ViewData["Title"] = "Статистика категорій";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Середній бал за категоріями</h2>
        <a asp-action="Dashboard" class="btn btn-secondary">Назад</a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Категорія</th>
                        <th style="width: 50%">Рейтинг</th>
                        <th class="text-center">Бал</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in Model)
                    {
                        var progressWidth = (stat.Value / 10.0) * 100;
                        <tr>
                            <td><strong>@stat.Key</strong></td>
                            <td>
                                <div class="progress" style="height: 15px;">
                                    <div class="progress-bar bg-warning" role="progressbar"
                                         style="width: @progressWidth%"
                                         aria-valuenow="@stat.Value" aria-valuemin="0" aria-valuemax="10"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary fs-6">@stat.Value.ToString("F2") / 10</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>