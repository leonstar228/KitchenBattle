﻿
@model Dictionary<KitchenBattle.Models.CategoryEnum, double>

@{
    ViewData["Title"] = "Статистика категорій";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5 header-section">
        <div>
            <h2 class="fw-bold m-0 d-flex align-items-center" style="color: #2C2C2A; font-size: 2rem;">
                <i class="bi bi-graph-up" style="margin-right: 0.75rem; color: var(--kb-primary);"></i>
                Рейтинг за категоріями
            </h2>
            <p class="text-muted m-0 mt-2 small">Середній бал оцінок страв у розрізі кулінарних категорій</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn kb-btn-back px-4 py-2">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
    </div>

    <div class="card kb-table-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle m-0">
                    <thead>
                        <tr>
                            <th class="py-3 px-4">
                                <i class="bi bi-bookmark" style="margin-right: 0.5rem;"></i>Категорія
                            </th>
                            <th class="py-3 px-4" style="width: 45%">Графік розподілу</th>
                            <th class="py-3 px-4 text-center">
                                <i class="bi bi-star" style="margin-right: 0.5rem;"></i>Середній бал
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in Model) {
                            var displayValue = stat.Value;
                            if (displayValue > 10.0) 
                            {
                                displayValue = 10.0; 
                            }
                            var progressWidth = (displayValue / 10.0) * 100;

                            <tr>
                                <td class="py-3 px-4">
                                    <span class="category-name">
                                        <span class="category-icon">
                                            @if (stat.Key.ToString() == "Салати") { <i class="bi bi-leaf"></i> }
                                            else if (stat.Key.ToString() == "Супи") { <i class="bi bi-cup-hot"></i> }
                                            else if (stat.Key.ToString() == "М'ясо") { <i class="bi bi-egg"></i> }
                                            else if (stat.Key.ToString() == "Риба") { <i class="bi bi-fish"></i> }
                                            else if (stat.Key.ToString() == "Овочі") { <i class="bi bi-broccoli"></i> }
                                            else { <i class="bi bi-cookware"></i> }
                                        </span>
                                        @stat.Key
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar"
                                             style="width: @progressWidth%"
                                             aria-valuenow="@displayValue" aria-valuemin="0" aria-valuemax="10"></div>
                                    </div>
                                </td>
                                <td class="text-center py-3 px-4">
                                    <span class="badge kb-badge-score">
                                        @(stat.Value > 10.0 ? "10.00" : stat.Value.ToString("F2")) / 10
                                    </span>
                                </td>
                            </tr> 
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>