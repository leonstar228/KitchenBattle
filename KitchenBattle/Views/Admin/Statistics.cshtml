@model Dictionary<KitchenBattle.Models.CategoryEnum, double>

@{
    ViewData["Title"] = "Статистика категорій";
}

<style>
    :root {
        --kb-primary: #4A6741;
        --kb-secondary: #C47B2B;
        --kb-bg: #F5F1E8;
        --kb-dark: #2C2C2A;
        --kb-neutral-600: #8B7355;
    }

    body { background-color: var(--kb-bg) !important; color: #2C2C2A; }

    .kb-table-card { 
        border: none; 
        border-radius: 12px; 
        background: #ffffff; 
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    .kb-table-card .card-body {
        padding: 2rem;
    }

    .table-responsive {
        border-radius: 8px;
    }

    .kb-table-card table thead th {
        background: linear-gradient(135deg, #FDFBF7 0%, #F9F5ED 100%) !important;
        color: var(--kb-neutral-600) !important;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1rem !important;
        border: none !important;
        font-weight: 600;
        border-bottom: 2px solid #E8D5A3 !important;
    }

    .kb-table-card table tbody td {
        padding: 1rem !important;
        border: none;
        vertical-align: middle;
    }

    .kb-table-card table tbody tr {
        border-bottom: 1px solid rgba(0,0,0,0.04);
        transition: all 0.3s ease;
    }

    .kb-table-card table tbody tr:hover {
        background-color: #FEFCF8 !important;
        box-shadow: inset 4px 0 0 var(--kb-secondary);
    }

    .progress { 
        background-color: #E8D5A3 !important; 
        border-radius: 8px; 
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        height: 16px;
    }

    .progress-bar { 
        background: linear-gradient(90deg, #C47B2B 0%, #D4913B 100%) !important;
        transition: width 0.6s ease;
        box-shadow: 0 -2px 6px rgba(0, 0, 0, 0.1) inset;
    }

    .kb-badge-score { 
        background: linear-gradient(135deg, #4A6741 0%, #6B8F5E 100%) !important; 
        color: #ffffff !important; 
        font-size: 0.9rem !important; 
        padding: 8px 14px !important; 
        border-radius: 6px !important; 
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(74, 103, 65, 0.2);
        display: inline-block;
    }

    .kb-btn-back { 
        background-color: transparent; 
        border: 2px solid var(--kb-neutral-600); 
        color: var(--kb-neutral-600); 
        font-weight: 600; 
        border-radius: 6px;
        transition: all 0.3s ease;
    }

    .kb-btn-back:hover { 
        background-color: var(--kb-neutral-600); 
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(139, 115, 85, 0.2);
    }

    .category-name {
        font-weight: 600;
        color: var(--kb-dark);
        display: flex;
        align-items: center;
    }

    .category-icon {
        font-size: 1.2rem;
        margin-right: 0.75rem;
        color: var(--kb-primary);
    }

    @@keyframes slideInAnim {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .header-section {
        animation: slideInAnim 0.6s ease-out;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5 header-section">
        <div>
            <h2 class="fw-bold m-0 d-flex align-items-center" style="color: #2C2C2A; font-size: 2rem;">
                <i class="bi bi-graph-up" style="margin-right: 0.75rem; color: var(--kb-primary);"></i>
                Рейтинг за категоріями
            </h2>
            <p class="text-muted m-0 mt-2 small">Середній бал оцінок страв у розрізі кулінарних категорій</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn kb-btn-back px-4 py-2">
            <i class="bi bi-arrow-left"></i> Назад
        </a>
    </div>

    <div class="card kb-table-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle m-0">
                    <thead>
                        <tr>
                            <th class="py-3 px-4">
                                <i class="bi bi-bookmark" style="margin-right: 0.5rem;"></i>Категорія
                            </th>
                            <th class="py-3 px-4" style="width: 45%">Графік розподілу</th>
                            <th class="py-3 px-4 text-center">
                                <i class="bi bi-star" style="margin-right: 0.5rem;"></i>Середній бал
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in Model) {
                            var displayValue = stat.Value;
                            if (displayValue > 10.0) 
                            {
                                displayValue = 10.0; 
                            }
                            var progressWidth = (displayValue / 10.0) * 100;

                            <tr>
                                <td class="py-3 px-4">
                                    <span class="category-name">
                                        <span class="category-icon">
                                            @if (stat.Key.ToString() == "Салаты") { <i class="bi bi-leaf"></i> }
                                            else if (stat.Key.ToString() == "Супы") { <i class="bi bi-cup-hot"></i> }
                                            else if (stat.Key.ToString() == "Мясо") { <i class="bi bi-egg"></i> }
                                            else if (stat.Key.ToString() == "Рыба") { <i class="bi bi-fish"></i> }
                                            else if (stat.Key.ToString() == "Овощи") { <i class="bi bi-broccoli"></i> }
                                            else { <i class="bi bi-cookware"></i> }
                                        </span>
                                        @stat.Key
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar"
                                             style="width: @progressWidth%"
                                             aria-valuenow="@displayValue" aria-valuemin="0" aria-valuemax="10"></div>
                                    </div>
                                </td>
                                <td class="text-center py-3 px-4">
                                    <span class="badge kb-badge-score">
                                        @(stat.Value > 10.0 ? "10.00" : stat.Value.ToString("F2")) / 10
                                    </span>
                                </td>
                            </tr> 
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>