@model KitchenBattle.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Адмін-панель";
}

<style>
    :root {
        --kb-primary: #4A6741;    
        --kb-secondary: #C47B2B;   
        --kb-bg: #F5F1E8;         
        --kb-dark: #2C2C2A;       
        --kb-green-400: #6B8F5E;   
        --kb-gold-200: #E8D5A3;    
        --kb-neutral-600: #8B7355; 
    }

    body {
        background-color: var(--kb-bg) !important;
        color: var(--kb-dark);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .kb-card {
        border: none;
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .kb-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.08) !important;
    }

    .kb-card-primary { background-color: var(--kb-primary); color: #ffffff; }
    .kb-card-success { background-color: var(--kb-green-400); color: #ffffff; }
    .kb-card-warning { background-color: var(--kb-gold-200); color: var(--kb-dark); }
    .kb-card-dark { background-color: var(--kb-dark); color: #ffffff; }

    .kb-list-item {
        background-color: #ffffff !important;
        color: var(--kb-dark) !important;
        border: 1px solid rgba(0,0,0,0.05) !important;
        margin-bottom: 10px;
        border-radius: 8px !important;
        transition: all 0.2s ease;
    }
    .kb-list-item:hover {
        background-color: #ffffff !important;
        border-color: var(--kb-secondary) !important;
        color: var(--kb-secondary) !important;
    }
    
    .kb-btn-action {
        border: 2px solid var(--kb-secondary);
        color: var(--kb-secondary);
        font-weight: 600;
        border-radius: 25px;
        background: transparent;
        transition: all 0.2s ease;
    }
    .kb-btn-action:hover {
        background-color: var(--kb-secondary);
        color: #ffffff;
    }

    .text-tracking {
        letter-spacing: 0.05em;
    }
</style>

<div class="container mt-5">
    <div class="mb-5">
        <h2 class="fw-bold m-0" style="color: var(--kb-dark);">Адмін-панель</h2>
        <p class="text-muted m-0" style="color: var(--kb-neutral-600);">Загальний огляд та керування показниками системи</p>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-primary h-100 shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-semibold">Всього користувачів</h6>
                    <h2 class="display-5 fw-bold my-2">@Model.TotalUsers</h2>
                    <div class="small opacity-90 border-top pt-2 mt-2">Шефи: @Model.TotalChefs | Судді: @Model.TotalJudges</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-success h-100 shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-semibold">Опубліковано рецептів</h6>
                    <h2 class="display-5 fw-bold my-2">@Model.PublishedRecipes</h2>
                    <div class="small opacity-90 border-top pt-2 mt-2">Очікують модерації: @Model.PendingRecipes</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-warning h-100 shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-bold">Всього батлів</h6>
                    <h2 class="display-5 fw-bold my-2">@Model.TotalBattles</h2>
                    <div class="small opacity-90 border-top pt-2 mt-2" style="border-top-color: rgba(0,0,0,0.1) !important;">Завершено: @Model.FinishedBattles</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-dark h-100 shadow-sm p-3">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-semibold mb-3">Аналітика оцінок</h6>
                    <a asp-controller="Admin" asp-action="Statistics" class="btn btn-sm kb-btn-action w-100 py-2">Переглянути статистику</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h5 class="fw-bold mb-3" style="color: var(--kb-neutral-600);">Розділи керування</h5>
        <div class="list-group shadow-sm">
            <a asp-controller="Admin" asp-action="RecipesForReview" class="list-group-item list-group-item-action kb-list-item d-flex justify-content-between align-items-center p-3 fw-semibold">
                <span>Модерація рецептів</span>
                <span class="badge rounded-pill px-3 py-2" style="background-color: #D4483B; color: #ffffff; font-weight: 500;">@Model.PendingRecipes</span>
            </a>
            <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action kb-list-item p-3 fw-semibold">
                Керування користувачами
            </a>
            <a asp-controller="Battles" asp-action="Index" class="list-group-item list-group-item-action kb-list-item p-3 fw-semibold">
                Керування батлами
            </a>
        </div>
    </div>
</div>