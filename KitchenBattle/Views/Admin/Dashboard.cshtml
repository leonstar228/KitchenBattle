@model KitchenBattle.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Адмін-панель";
}

<style>
    :root {
        --kb-primary: #4A6741;    
        --kb-secondary: #C47B2B;   
        --kb-bg: #F5F1E8;         
        --kb-dark: #2C2C2A;       
        --kb-green-400: #6B8F5E;   
        --kb-gold-200: #E8D5A3;    
        --kb-neutral-600: #8B7355; 
    }

    body {
        background-color: var(--kb-bg) !important;
        color: var(--kb-dark);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .kb-card {
        border: none;
        border-radius: 12px;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-left-color 0.3s ease;
        border-left: 4px solid transparent;
        position: relative;
        overflow: hidden;
    }

    .kb-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, rgba(255,255,255,0.5), rgba(255,255,255,0));
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .kb-card:hover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 12px 20px rgba(0,0,0,0.12) !important;
    }

    .kb-card:hover::before {
        opacity: 1;
    }

    .kb-card-primary { 
        background-color: var(--kb-primary); 
        color: #ffffff; 
        border-left-color: var(--kb-primary);
    }
    .kb-card-success { 
        background-color: var(--kb-green-400); 
        color: #ffffff;
        border-left-color: var(--kb-green-400);
    }
    .kb-card-warning { 
        background-color: var(--kb-gold-200); 
        color: var(--kb-dark);
        border-left-color: var(--kb-gold-200);
    }
    .kb-card-dark { 
        background-color: var(--kb-dark); 
        color: #ffffff;
        border-left-color: var(--kb-dark);
    }

    .card-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        opacity: 0.9;
    }

    .kb-list-item {
        background-color: #ffffff !important;
        color: var(--kb-dark) !important;
        border: 1px solid rgba(0,0,0,0.05) !important;
        margin-bottom: 10px;
        border-radius: 8px !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        border-left: 4px solid transparent !important;
        padding-left: calc(1rem - 4px) !important;
    }

    .kb-list-item:hover {
        background-color: #ffffff !important;
        border-color: var(--kb-secondary) !important;
        border-left-color: var(--kb-secondary) !important;
        color: var(--kb-secondary) !important;
        transform: translateX(4px);
        box-shadow: 0 4px 12px rgba(196, 123, 43, 0.1) !important;
    }

    .kb-list-item .badge {
        transition: all 0.3s ease;
    }

    .kb-list-item:hover .badge {
        transform: scale(1.1);
    }

    .kb-btn-action {
        border: 2px solid var(--kb-secondary);
        color: var(--kb-secondary);
        font-weight: 600;
        border-radius: 25px;
        background: transparent;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .kb-btn-action::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background-color: var(--kb-secondary);
        transition: left 0.3s ease;
        z-index: -1;
    }

    .kb-btn-action:hover {
        background-color: var(--kb-secondary);
        color: #ffffff;
        box-shadow: 0 6px 20px rgba(196, 123, 43, 0.3);
        transform: translateY(-2px);
    }

    .text-tracking {
        letter-spacing: 0.05em;
    }

    .header-section {
        animation: slideInAnim 0.6s ease-out;
    }

    @@keyframes slideInAnim {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stats-row {
        animation: fadeInAnim 0.8s ease-out;
    }

    @@keyframes fadeInAnim {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

<div class="container mt-5">
    <div class="mb-5 header-section">
        <h2 class="fw-bold m-0 d-flex align-items-center" style="color: var(--kb-dark); font-size: 2rem;">
            <i class="bi bi-speedometer2" style="margin-right: 0.5rem; color: var(--kb-primary);"></i>
            Адмін-панель
        </h2>
        <p class="text-muted m-0 mt-2" style="color: var(--kb-neutral-600); font-size: 1rem;">Загальний огляд та керування показниками системи</p>
    </div>

    <div class="row stats-row">
        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-primary h-100 shadow-sm p-4">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <div class="card-icon"><i class="bi bi-people-fill"></i></div>
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-semibold">Всього користувачів</h6>
                    <h2 class="display-4 fw-bold my-2">@Model.TotalUsers</h2>
                    <div class="small opacity-90 border-top pt-2 mt-2">
                        <span style="margin-right: 1rem;"><i class="bi bi-person-check"></i> Шефи: @Model.TotalChefs</span>
                        <span><i class="bi bi-person-badge"></i> Судді: @Model.TotalJudges</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-success h-100 shadow-sm p-4">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <div class="card-icon"><i class="bi bi-book-half"></i></div>
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-semibold">Опубліковано рецептів</h6>
                    <h2 class="display-4 fw-bold my-2">@Model.PublishedRecipes</h2>
                    <div class="small opacity-90 border-top pt-2 mt-2">
                        <i class="bi bi-clock-history"></i> Очікують модерації: @Model.PendingRecipes
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-warning h-100 shadow-sm p-4">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <div class="card-icon"><i class="bi bi-lightning-fill"></i></div>
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-bold">Всього батлів</h6>
                    <h2 class="display-4 fw-bold my-2">@Model.TotalBattles</h2>
                    <div class="small opacity-90 border-top pt-2 mt-2" style="border-top-color: rgba(0,0,0,0.1) !important;">
                        <i class="bi bi-check-circle"></i> Завершено: @Model.FinishedBattles
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card kb-card kb-card-dark h-100 shadow-sm p-4">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <div class="card-icon"><i class="bi bi-graph-up"></i></div>
                    <h6 class="text-uppercase text-tracking small opacity-75 fw-semibold mb-3">Аналітика оцінок</h6>
                    <a asp-controller="Admin" asp-action="Statistics" class="btn btn-sm kb-btn-action w-100 py-2">
                        <i class="bi bi-arrow-right"></i> Переглянути
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <h5 class="fw-bold mb-4 d-flex align-items-center" style="color: var(--kb-neutral-600); font-size: 1.25rem;">
            <i class="bi bi-gear" style="margin-right: 0.5rem; color: var(--kb-primary);"></i>
            Розділи керування
        </h5>
        <div class="list-group shadow-sm">
            <a asp-controller="Admin" asp-action="RecipesForReview" class="list-group-item list-group-item-action kb-list-item d-flex justify-content-between align-items-center p-4 fw-semibold">
                <span><i class="bi bi-bookmark-check" style="margin-right: 0.75rem; font-size: 1.1rem;"></i>Модерація рецептів</span>
                <span class="badge rounded-pill px-3 py-2" style="background: linear-gradient(135deg, #D4483B 0%, #b8392e 100%); color: #ffffff; font-weight: 500; box-shadow: 0 2px 8px rgba(212, 72, 59, 0.3);">@Model.PendingRecipes</span>
            </a>
            <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action kb-list-item p-4 fw-semibold">
                <i class="bi bi-person-gear" style="margin-right: 0.75rem; font-size: 1.1rem;"></i>Керування користувачами
            </a>
            <a asp-controller="Battles" asp-action="Index" class="list-group-item list-group-item-action kb-list-item p-4 fw-semibold">
                <i class="bi bi-sword" style="margin-right: 0.75rem; font-size: 1.1rem;"></i>Керування батлами
            </a>
        </div>
    </div>
</div>
