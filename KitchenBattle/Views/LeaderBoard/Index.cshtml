@model List<KitchenBattle.ViewModels.LeaderboardViewModel>

@{
    ViewData["Title"] = "Лідерборд";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Лідерборд</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
            <tr>
                <th scope="col">Місце</th>
                <th scope="col">Назва рецепта</th>
                <th scope="col">Шеф</th>
                <th scope="col">Категорія</th>
                <th scope="col">Середній бал</th>
                <th scope="col">Кількість оцінок</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Place</strong></td>
                    <td>@item.RecipeTitle</td>
                    <td>@item.ChefName</td>
                    <td>@item.Category</td>
                    <td>@item.AverageScore.ToString("0.00")</td>
                    <td>@item.TotalScoresCount</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>