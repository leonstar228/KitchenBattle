@model List<KitchenBattle.ViewModels.LeaderboardViewModel>

@{
    ViewData["Title"] = "Лідерборд";
}

<div class="container py-5">
    <div class="page-header-centered">
        <h1 class="display-5 fw-bold">Лідерборд</h1>
        <p class="lead">Найкращі рецепти нашого кухарського батлу</p>
    </div>

    <div class="row g-4 mb-5">
        @for (int i = 0; i < Math.Min(3, Model.Count); i++)
        {
            var item = Model[i];
            var colorClass = i switch
            {
                0 => "top-1",
                1 => "top-2",
                2 => "top-3",
                _ => "top-1"
            };

            <div class="col-lg-4 col-md-6">
                <div class="leader-card h-100 @colorClass position-relative" style="border-radius: 16px; overflow: hidden;">
                    <div class="place-badge">
                        <span class="badge rounded-pill fs-3 fw-bold">@item.Place</span>
                    </div>

                    <img src="https://img.freepik.com/free-photo/top-view-yummy-dovga-yogurt-soup-with-seasonings-white-milk-soup-dairy_140725-124527.jpg?semt=ais_hybrid&w=740&q=80" 
                         class="card-img-top" 
                         style="height: 240px; object-fit: cover; width: 100%;"
                         alt="@item.RecipeTitle" />

                    <div class="p-4 text-white d-flex flex-column" style="height: calc(100% - 240px);">
                        <h5 class="fw-bold mb-2">@item.RecipeTitle</h5>
                        <p class="mb-3 opacity-90">👨‍🍳 @item.ChefName</p>
                        
                        <div class="mt-auto">
                            <span class="badge mb-3" style="background: rgba(255,255,255,0.95); color: #2C2C2A; font-weight: 500;">
                                @item.Category
                            </span>
                            
                            <div class="d-flex justify-content-between align-items-end">
                                <div class="stars fs-4">★★★★☆</div>
                                <div class="text-end">
                                    <strong class="fs-2">@item.AverageScore.ToString("0.0")</strong>
                                    <small class="d-block opacity-75">(@item.TotalScoresCount)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <h4 class="mb-4" style="color: #2C2C2A;">Повний рейтинг</h4>
    
    <div class="row g-3">
        @for (int i = 3; i < Model.Count; i++)
        {
            var item = Model[i];
            
            <div class="col-12">
                <div class="leader-row d-flex align-items-center p-4 bg-white rounded-4 shadow-sm">
                    <div class="place-number me-4">
                        <strong class="fs-3" style="color: #4A6741;">#@item.Place</strong>
                    </div>
                    
                    <div class="flex-grow-1">
                        <h6 class="mb-1 fw-semibold">@item.RecipeTitle</h6>
                        <small style="color: #8B7355;">👨‍🍳 @item.ChefName • @item.Category</small>
                    </div>
                    
                    <div class="text-end">
                        <div class="d-flex align-items-center gap-2">
                            <span style="color: #C47B2B; font-size: 1.5rem;">★</span>
                            <strong class="fs-3">@item.AverageScore.ToString("0.00")</strong>
                        </div>
                        <small style="color: #8B7355;">@item.TotalScoresCount оцінок</small>
                    </div>
                </div>
            </div>
        }
    </div>
</div>