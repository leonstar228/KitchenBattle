﻿@{
    ViewData["Title"] = "Доступ заборонено";
}

<div class="denied-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-sm-9">
                <div class="denied-card">
                    <div class="denied-top">
                        <div class="denied-icon"><i class="bi bi-shield-lock-fill"></i></div>
                        <h2>Доступ заборонено</h2>
                    </div>
                    <div class="denied-body">
                        <p>У вас недостатньо прав для виконання цієї дії.</p>
                        <div class="role-hint">
                            <i class="bi bi-info-circle"></i>
                            <strong>Щоб створювати рецепти</strong> — потрібна роль <code>chef</code>.<br>
                            <strong>Щоб оцінювати</strong> — роль <code>judge</code>.<br>
                            Зверніться до адміністратора для отримання потрібних прав.
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="btn-home">
                            <i class="bi bi-house-fill"></i> На головну
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>