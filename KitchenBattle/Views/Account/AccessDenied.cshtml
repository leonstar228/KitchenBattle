@{
    ViewData["Title"] = "Доступ заборонено";
}

<style>
    :root {
        --clr-green: #4A6741;
        --clr-gold: #C47B2B;
        --clr-gold-light: #E8D5A3;
        --clr-ivory: #F5F1E8;
        --clr-white: #FFFFFF;
        --clr-dark: #2C2C2A;
        --clr-brown: #8B7355;
        --clr-red: #D4483B;
    }

    body {
        background: var(--clr-ivory) !important;
    }

    .denied-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        padding: 60px 0;
    }

    .denied-card {
        background: var(--clr-white);
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        overflow: hidden;
        border-top: 4px solid var(--clr-gold);
        animation: pop .45s cubic-bezier(.34,1.56,.64,1) both;
        text-align: center;
    }

    @@keyframes pop {
        from {
            opacity: 0;
            transform: scale(.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .denied-top {
        background: linear-gradient(135deg,var(--clr-green),#3d5534);
        padding: 36px 32px;
    }

    .denied-icon {
        font-size: 60px;
        color: var(--clr-gold-light);
        margin-bottom: 12px;
    }

    .denied-top h2 {
        font-family: 'Georgia',serif;
        font-size: 26px;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .denied-body {
        padding: 32px;
    }

        .denied-body p {
            font-size: 15px;
            color: var(--clr-dark);
            margin-bottom: 24px;
        }

    .role-hint {
        background: var(--clr-ivory);
        border-left: 3px solid var(--clr-gold);
        border-radius: 0 8px 8px 0;
        padding: 12px 16px;
        font-size: 13px;
        color: var(--clr-brown);
        text-align: left;
        margin-bottom: 24px;
    }

    .btn-home {
        background: var(--clr-gold);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 32px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .3s ease;
    }

        .btn-home:hover {
            background: #b36520;
            color: #fff;
            transform: translateY(-2px);
        }
</style>

<div class="denied-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-sm-9">
                <div class="denied-card">
                    <div class="denied-top">
                        <div class="denied-icon"><i class="bi bi-shield-lock-fill"></i></div>
                        <h2>Доступ заборонено</h2>
                    </div>
                    <div class="denied-body">
                        <p>У вас недостатньо прав для виконання цієї дії.</p>
                        <div class="role-hint">
                            <i class="bi bi-info-circle"></i>
                            <strong>Щоб створювати рецепти</strong> — потрібна роль <code>chef</code>.<br>
                            <strong>Щоб оцінювати</strong> — роль <code>judge</code>.<br>
                            Зверніться до адміністратора для отримання потрібних прав.
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="btn-home">
                            <i class="bi bi-house-fill"></i> На головну
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>